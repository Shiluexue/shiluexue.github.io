<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Reframing Trip.com Search for the AI era | Shilue's Portfolio</title>
  <meta name="description" content="As Search Design Lead, reframing Trip.com Search from a keyword-matching transaction entry into a travel decision gateway — driving vision and design across three staged AI initiatives." />
  <link rel="icon" type="image/png" href="../images/avatar-header.png" />
  <link rel="preload" href="../fonts/AirbnbCereal_W_Bk.otf" as="font" type="font/otf" crossorigin>
  <link rel="preload" href="../fonts/AirbnbCereal_W_Bd.otf" as="font" type="font/otf" crossorigin>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>

/* ============ Visionary design alternatives — HTML wireframe phones ============ */
.alts-wrap{margin:56px calc(50% - 50vw + 8px) 24px;background:#F4F7FA;padding:64px 32px 56px;border-radius:8px;overflow-x:auto}
.alts-grid{display:grid;grid-template-columns:2.1fr 1fr 1fr 1fr;gap:40px;max-width:1720px;margin:0 auto;align-items:start}
.alts-item{display:flex;flex-direction:column;gap:28px}
.alts-item__phones{display:flex;justify-content:center;gap:24px;position:relative}
.alts-item--dual .alts-item__phones{gap:16px;align-items:center}
.alts-arrow{color:rgba(15,24,33,.35);font-size:26px;line-height:1;align-self:center;padding:0 6px}
.alts-item__pc{display:flex;flex-direction:column;gap:16px;font-family:var(--font-sans);padding:0 8px}
.alts-pc__pros,.alts-pc__cons{margin:0;font-size:14px;line-height:1.55;color:var(--c-body);font-weight:400}
.alts-pc__pros strong,.alts-pc__cons strong{display:block;font-size:11px;font-weight:700;color:var(--c-text-deep);letter-spacing:0.15em;text-transform:uppercase;margin:0 0 8px}
.alts-pc__cons strong{color:#9A6C3F}

.alts-annotate{position:absolute;top:20px;left:-4px;display:flex;align-items:center;gap:10px;pointer-events:none;z-index:6}
.alts-annotate__label{font-size:12px;font-weight:600;color:var(--c-body);background:#fff;padding:5px 12px;border-radius:4px;box-shadow:0 2px 8px -2px rgba(15,24,33,.15);white-space:nowrap}
.alts-annotate__line{width:32px;height:1px;background:#B57C99}

.alt-phone{width:260px;height:560px;background:#fff;border:1.5px solid rgba(15,24,33,.14);border-radius:32px;padding:6px 6px 0;display:flex;flex-direction:column;position:relative;box-shadow:0 14px 32px -14px rgba(15,24,33,.18),0 4px 10px -3px rgba(15,24,33,.06);flex-shrink:0;overflow:hidden}
.alt-phone__notch{position:absolute;top:3px;left:50%;transform:translateX(-50%);width:70px;height:16px;background:#0F1821;border-radius:0 0 14px 14px;z-index:2}
.alt-phone__status{display:flex;justify-content:space-between;align-items:center;padding:7px 14px 5px;font-size:9px;font-weight:700;color:#0F1821;position:relative;z-index:3}
.alt-phone__status-icons{display:inline-flex;gap:4px;align-items:center;color:#0F1821}
.alt-phone__status-icons svg{height:8px;width:auto;display:block}
.alt-phone__pill{align-self:flex-start;margin:6px 14px 10px;padding:4px 10px;background:#EEF0F3;border-radius:20px;font-size:9px;font-weight:700;color:#0F1821;display:inline-flex;align-items:center;gap:5px}
.alt-phone__pill-icon{color:var(--c-blue);font-size:9px}
.alt-phone__body{flex:1;padding:0 10px;display:flex;flex-direction:column;gap:8px;overflow:hidden}
.soc-phone .alt-phone__body{overflow:visible}
.alt-section{background:#F1F3F5;border-radius:7px;padding:10px}
.alt-section--tight{padding:10px}
.alt-section--banner{min-height:72px;background:transparent;position:relative;padding:0;overflow:visible;display:flex;align-items:stretch;justify-content:center;gap:6px}
.alt-banner-slide{flex:0 0 78%;background:#E4E7EC;border-radius:7px;display:flex;align-items:center;justify-content:center;position:relative}
.alt-banner-slide--peek{flex:0 0 6%;background:#EAECEF;border-radius:4px;opacity:0.7}
.alt-section--qa{flex:1;min-height:0}
.alt-section__label{font-size:9px;font-weight:700;color:#0F1821;margin:0 0 5px}
.alt-banner-icon{width:26px;height:16px;background:#D3D9DE;border-radius:3px}
.alt-banner-dot{position:absolute;bottom:6px;left:50%;transform:translateX(-50%);width:16px;height:2.5px;background:#6BC79E;border-radius:2px}
.alt-cards-2{display:grid;grid-template-columns:1fr 1fr;gap:5px}
.alt-cards-2 div{background:#E4E7EC;border-radius:4px;height:34px}
.alt-cards-stack{display:flex;flex-direction:column;gap:4px}
.alt-cards-stack div{background:#E4E7EC;border-radius:3.5px;height:17px;flex:1;min-height:16px}
.alt-cards-3{display:flex;gap:6px;overflow:hidden;padding-right:8px;margin:2px -2px 0 -2px}
.alt-featurecard{flex:0 0 46%;background:#fff;border-radius:6px;padding:8px 8px 6px;display:flex;flex-direction:column;gap:2px;min-height:66px;box-shadow:0 1px 2px rgba(15,24,33,.04)}
.alt-featurecard__title{font-size:9px;font-weight:700;color:#0F1821;margin:0;line-height:1.2}
.alt-featurecard__desc{font-size:8px;color:#4A5868;margin:0;line-height:1.2}
.alt-featurecard__pips{margin-top:auto;display:flex;padding-top:4px}
.alt-featurecard__pips span{width:14px;height:14px;border-radius:50%;background:#F5F5F7;border:1.5px solid #fff;display:inline-block;box-shadow:0 0 0 0.5px rgba(15,24,33,.14)}
.alt-featurecard__pips span:not(:first-child){margin-left:-5px}
.alt-mentors{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-top:2px}
.alt-mentor{background:#fff;border-radius:5px;padding:7px;display:flex;flex-direction:column;gap:5px}
.alt-mentor__head{display:flex;gap:5px;align-items:center}
.alt-mentor__avatar{display:block;width:14px;height:14px;background:transparent;border:1px solid #C7CDD3;border-radius:50%;flex-shrink:0}
.alt-mentor__meta-col{display:flex;flex-direction:column;gap:0;min-width:0}
.alt-mentor__name{font-size:8px;font-weight:700;color:#0F1821;margin:0;line-height:1.15;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.alt-mentor__meta{font-size:7px;color:var(--c-blue);margin:0;line-height:1.15;font-weight:500}
.alt-mentor__quote{font-size:7px;color:#0F1821;margin:0;line-height:1.3;font-weight:400;padding:5px;border:1px solid #E4E7EC;border-radius:3px;background:#fff}
.alt-choice-row{display:grid;grid-template-columns:1fr 1fr;gap:5px;margin-top:2px}
.alt-choice{background:#F1F3F5;border-radius:7px;padding:10px 8px;display:flex;flex-direction:column;gap:2px;align-items:flex-start}
.alt-choice__icon{color:var(--c-blue);font-size:14px;line-height:1;margin-bottom:2px}
.alt-choice__title{font-size:9px;font-weight:700;color:#0F1821;margin:0;line-height:1.2}
.alt-choice__desc{font-size:7.5px;color:#4A5868;margin:0;line-height:1.25}
.alt-phone__sheet-scrim{position:absolute;inset:0;background:rgba(15,24,33,.22);z-index:4;border-radius:30px;pointer-events:none}
.alt-phone__sheet{position:absolute;bottom:0;left:0;right:0;background:#fff;border-radius:16px 16px 0 0;padding:9px 16px 16px;display:flex;flex-direction:column;gap:7px;z-index:5;box-shadow:0 -8px 22px -6px rgba(15,24,33,.15)}
.alt-phone__sheet-grip{width:36px;height:3.5px;background:rgba(15,24,33,.18);border-radius:2px;margin:0 auto 5px}
.alt-sheet-item{font-size:10px;font-weight:600;color:#0F1821;background:#fff;border:1px solid rgba(15,24,33,.10);border-radius:7px;padding:8px 11px;text-align:center}
.alt-phone__tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;padding:8px 5px 10px;border-top:1px solid rgba(15,24,33,.08);margin-top:5px}
.alt-tab{display:flex;flex-direction:column;align-items:center;gap:2.5px;font-size:7.5px;color:#4A5868;font-weight:500}
.alt-tab--active{color:var(--c-blue);font-weight:700}
.alt-tab__icon{width:16px;height:16px;display:flex;align-items:center;justify-content:center;color:currentColor}
.alt-tab__icon svg{width:14px;height:14px;display:block;fill:none;stroke:currentColor;stroke-width:1.4}
.alt-tab--active .alt-tab__icon svg[data-fill]{fill:var(--c-blue);stroke:none}
@media (max-width:1200px){.alts-grid{grid-template-columns:1fr 1fr;gap:32px}.alts-item--dual{grid-column:1 / -1}}
@media (max-width:700px){.alts-grid{grid-template-columns:1fr}.alts-item--dual{grid-column:auto}.alts-wrap{padding:36px 16px}.alt-phone{width:180px;height:390px}}


/* ============ Solve of conflicts — 2 phones + annotated red-dashed callouts ============ */
.soc-wrap{margin:56px auto;max-width:1200px;padding:56px 220px;background:#F4F7FA;border-radius:8px;overflow:visible}
.soc-grid{display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:start;justify-items:center;overflow:visible}
.soc-item{display:flex;flex-direction:column;align-items:center;gap:20px;position:relative;padding:0}
.soc-phone{overflow:visible !important}
.soc-header{display:flex;justify-content:space-between;align-items:center;padding:4px 14px 8px;border-bottom:1px solid rgba(15,24,33,.08);margin:0 4px}
.soc-header__title{font-size:12px;font-weight:700;color:var(--c-text-deep);margin:0}
.soc-header__icons{display:flex;gap:6px;align-items:center;color:var(--c-text-deep)}
.soc-header__ico{font-size:11px;line-height:1}
.soc-stories{display:flex;justify-content:space-between;padding:8px 10px;background:transparent}
.soc-story{display:flex;flex-direction:column;align-items:center;gap:4px}
.soc-story span:first-child{width:26px;height:26px;border:1.5px solid #C7CDD3;border-radius:50%;display:block}
.soc-story__lbl{font-size:8px;color:#4A5868;font-weight:500}
.soc-single-banner{display:flex;align-items:center;justify-content:center;flex-direction:column;gap:6px;min-height:80px;background:#EAECEF}
.soc-single-banner__icon{font-size:16px;color:#8992A3;line-height:1}
.soc-single-banner__lbl{font-size:9px;font-weight:600;color:#4A5868}
.soc-big-carousel{min-height:110px !important}
.soc-big-carousel .alt-banner-slide{border-radius:12px}
.soc-big-carousel .alt-banner-icon{width:44px;height:30px}
/* Red dashed annotation box — extends 4px outside the element */
.soc-annobox{position:relative}
.soc-annobox::after{content:"";position:absolute;inset:-4px;border:1.5px dashed #D0342C;border-radius:8px;pointer-events:none;z-index:3}
/* Callouts — position outside the phone via right:100% / left:100% */
.soc-callout{position:absolute;font-family:var(--font-sans);display:flex;flex-direction:column;gap:5px;width:180px;z-index:4}
.soc-callout__title{font-size:13px;font-weight:700;color:var(--c-text-deep);margin:0;line-height:1.25}
.soc-callout__body{font-size:11.5px;line-height:1.4;color:var(--c-body);margin:0;font-weight:400}
.soc-callout--top-left{right:100%;margin-right:24px;top:110px;text-align:right;align-items:flex-end}
.soc-callout--mid-left{right:100%;margin-right:24px;top:340px;text-align:right;align-items:flex-end}
.soc-callout--top-right{left:100%;margin-left:24px;top:130px;text-align:left;align-items:flex-start}
/* Pink dot + connector line */
.soc-callout--top-left::before,.soc-callout--mid-left::before{content:"";position:absolute;width:8px;height:8px;background:#B57C99;border-radius:50%;right:-32px;top:6px}
.soc-callout--top-right::before{content:"";position:absolute;width:8px;height:8px;background:#B57C99;border-radius:50%;left:-32px;top:6px}
.soc-callout--top-left::after,.soc-callout--mid-left::after{content:"";position:absolute;height:1px;background:#B57C99;right:-24px;top:10px;width:24px}
.soc-callout--top-right::after{content:"";position:absolute;height:1px;background:#B57C99;left:-24px;top:10px;width:24px}
/* Caption below phones */
.soc-caption{display:flex;flex-direction:column;align-items:center;gap:6px;margin-top:20px;text-align:center}
.soc-caption__title{font-size:15px;font-weight:700;color:var(--c-text-deep);margin:0;font-family:var(--font-sans)}
.soc-caption__selected{font-size:13px;font-weight:600;color:#2A9D5C;margin:0;font-family:var(--font-sans);display:flex;align-items:center;gap:6px}
.soc-caption__selected--placeholder{color:transparent}
.soc-caption__check{width:16px;height:16px;background:#2A9D5C;color:#fff;border-radius:3px;display:inline-flex;align-items:center;justify-content:center;font-size:10px;font-weight:700}

@media (max-width:1200px){
  .soc-wrap{padding:56px 40px}
  .soc-callout--top-left,.soc-callout--mid-left,.soc-callout--top-right{position:static;width:auto;max-width:none;text-align:left;align-items:flex-start;margin:12px 0}
  .soc-callout::before,.soc-callout::after{display:none}
}
@media (max-width:768px){.soc-grid{grid-template-columns:1fr;gap:56px}.soc-wrap{padding:32px 20px}}

/* ============ A11y baseline: focus-visible + reduced-motion ============ */
*:focus { outline: none; }
a:focus-visible, button:focus-visible, [tabindex]:focus-visible, .card:focus-visible, .card:focus-within {
  outline: 2px solid #0A66C2;
  outline-offset: 3px;
  border-radius: 4px;
}
@media (prefers-reduced-motion: reduce) {
  *, *::before, *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
  video[autoplay] { display: none; }
}


@font-face { font-family: 'Airbnb Cereal App'; font-weight: 300; font-style: normal; src: url('../fonts/AirbnbCereal_W_Lt.otf') format('opentype'); font-display: swap; }
@font-face { font-family: 'Airbnb Cereal App'; font-weight: 400; font-style: normal; src: url('../fonts/AirbnbCereal_W_Bk.otf') format('opentype'); font-display: swap; }
@font-face { font-family: 'Airbnb Cereal App'; font-weight: 500; font-style: normal; src: url('../fonts/AirbnbCereal_W_Md.otf') format('opentype'); font-display: swap; }
@font-face { font-family: 'Airbnb Cereal App'; font-weight: 700; font-style: normal; src: url('../fonts/AirbnbCereal_W_Bd.otf') format('opentype'); font-display: swap; }
@font-face { font-family: 'Airbnb Cereal App'; font-weight: 800; font-style: normal; src: url('../fonts/AirbnbCereal_W_XBd.otf') format('opentype'); font-display: swap; }
@font-face { font-family: 'Airbnb Cereal App'; font-weight: 900; font-style: normal; src: url('../fonts/AirbnbCereal_W_Blk.otf') format('opentype'); font-display: swap; }

/* Fallback fonts sized to match Cereal metrics — reduces FOUT layout shift */
@font-face {
  font-family: 'Cereal-fallback';
  src: local('Arial');
  size-adjust: 102%;
  ascent-override: 92%;
  descent-override: 22%;
  line-gap-override: 0%;
}


:root{
  /* Colors */
  --c-text:#1C3142; --c-text-deep:#0E1821; --c-body:#464545;
  --c-l1:#DBDBDB;                          /* L1 watermark heading */
  --c-blue:#0A66C2;            /* unified blue — only blue used on the page */
  --c-bg:#FFFFFF; --c-container-bg:#F8F8FA;     /* unified container/box background */
  --c-meta-bg:var(--c-container-bg);
  --c-callout-blue:#E9F1FB; --c-card-blue:#EFF5FE;
  --c-accent:#C24A3A;

  /* Typography */
  /* Font: Airbnb Cereal is Airbnb's proprietary paid font (not freely available).
     Inter is the closest open-source alternative, loaded via Google Fonts above.
     If you have the Airbnb Cereal font files, drop them in /fonts/ and add @font-face. */
  --font-sans:"Airbnb Cereal App","Cereal-fallback","Inter","-apple-system","BlinkMacSystemFont","Helvetica Neue",Arial,sans-serif;

  /* Container */
  --container-width:1140px; --header-height:80px; --side-pad:0px;

  /* SPACING SYSTEM */
  --gap-l1-top:160px;        /* before L1 watermark */
  --gap-l1-bottom:32px;      /* after L1 watermark */
  --gap-l2-top:64px;         /* between L2 modules (heading + body block) — single source of truth */
  --gap-l2-bottom:16px;      /* after L2 to body */
  --gap-para:24px;           /* paragraph to paragraph */
  --gap-text-to-img:40px;    /* text to image */
  --gap-img-to-text:56px;    /* image to text */
  --gap-img-to-img:48px;     /* image to image */
  --gap-caption-to-img:16px; /* image caption above image */
  --gap-section-block:64px;  /* generic block-to-block in same section */
  --container-pad:64px;      /* padding inside grey/blue containers */
}
*{box-sizing:border-box}
html{overflow-y:scroll;scroll-behavior:smooth}
html,body{margin:0;padding:0;background:var(--c-bg);color:var(--c-body);font-family:var(--font-sans);font-size:17px;font-weight:400;line-height:1.7;-webkit-font-smoothing:antialiased}
a{color:inherit;text-decoration:none}
a:hover{opacity:.85;transition:opacity .2s ease}
.brand:hover{opacity:1}
img{max-width:100%;display:block}

/* ============ Header ============ */
.site-header{position:fixed;top:0;left:0;right:0;width:100%;background:transparent;z-index:100;height:var(--header-height);display:flex;align-items:center;border-bottom:1px solid transparent;transition:background-color .35s cubic-bezier(.4,0,.2,1),backdrop-filter .35s cubic-bezier(.4,0,.2,1),-webkit-backdrop-filter .35s cubic-bezier(.4,0,.2,1),border-color .35s cubic-bezier(.4,0,.2,1),box-shadow .35s cubic-bezier(.4,0,.2,1),transform .35s cubic-bezier(.4,0,.2,1)}
.site-header.is-hidden{transform:translateY(-100%)}
body{padding-top:var(--header-height)}
.site-header.is-scrolled{background:rgba(255,255,255,.55);backdrop-filter:saturate(160%) blur(28px);-webkit-backdrop-filter:saturate(160%) blur(28px);border-bottom-color:rgba(15,24,33,.08);box-shadow:0 4px 24px -10px rgba(15,24,33,.10)}
.site-header__inner{display:flex;align-items:center;justify-content:space-between;width:100%}
.brand{display:flex;align-items:center;gap:12px;font-size:18px;font-weight:700;color:var(--c-text)}
.brand-avatar{position:relative;width:38px;height:40px;flex-shrink:0}
.brand-avatar img{position:absolute;top:0;left:0;width:38px;height:40px;object-fit:cover;border-radius:50%;transition:opacity .2s ease,transform .4s cubic-bezier(.4,0,.2,1)}
.brand-avatar__hover{opacity:0}
.brand:hover .brand-avatar__default{opacity:0}
.brand:hover .brand-avatar__hover{opacity:1}
.brand:hover .brand-avatar img{transform:scale(1.05)}
.nav{display:flex;gap:60px;align-items:center}
.nav a{position:relative;display:inline-block;padding:6px 0;font-size:16px;font-weight:500;color:var(--c-text);transition:color .25s cubic-bezier(.4,0,.2,1)}
.nav a::after{content:"";position:absolute;left:0;bottom:0;width:100%;height:2px;background:currentColor;transform:scaleX(0);transform-origin:left center;transition:transform .35s cubic-bezier(.65,0,.35,1)}
.nav a:hover::after,.nav a.is-active::after{transform:scaleX(1)}
.nav a.is-active{color:#0A66C2}

/* ============ Container ============ */
.container{max-width:var(--container-width);margin:0 auto;padding-left:var(--side-pad);padding-right:var(--side-pad)}
.site-header > .container{padding-left:var(--side-pad);padding-right:var(--side-pad)}

/* ============ Anchor scroll offset (account for sticky header + section-nav) ============ */
main section[id]{scroll-margin-top:140px}
@media (max-width:768px){main section[id]{scroll-margin-top:110px}}

/* ============ Section navigation (sticky top bar below main header) ============ */
.section-nav{position:sticky;top:0;z-index:101;background:rgba(255,255,255,.92);backdrop-filter:saturate(160%) blur(20px);-webkit-backdrop-filter:saturate(160%) blur(20px);border-bottom:1px solid rgba(15,24,33,.06);margin:32px 0 0;transition:top .35s cubic-bezier(.4,0,.2,1),box-shadow .3s ease}
.section-nav.is-stuck{box-shadow:0 4px 20px -8px rgba(15,24,33,.10)}
.section-nav.below-header{top:var(--header-height)}
.section-nav__inner{display:flex;align-items:center;justify-content:center;gap:48px;max-width:var(--container-width);margin:0 auto;padding:14px var(--side-pad);overflow-x:auto;-webkit-overflow-scrolling:touch;scrollbar-width:none}
.section-nav__inner::-webkit-scrollbar{display:none}
.section-nav__link{font-size:13px;font-weight:500;color:var(--c-body);letter-spacing:0.08em;text-transform:uppercase;padding:8px 0;position:relative;transition:color .2s ease;white-space:nowrap;flex-shrink:0}
.section-nav__link:hover{color:var(--c-text-deep);opacity:1}
.section-nav__link.is-active{color:var(--c-blue);font-weight:700}
.section-nav__link.is-active::after{content:"";position:absolute;left:50%;bottom:-15px;transform:translateX(-50%);width:100%;height:2px;background:var(--c-blue);border-radius:2px}
@media (max-width:768px){.section-nav__inner{justify-content:flex-start;gap:28px;padding:12px 20px}.section-nav__link{font-size:12px;letter-spacing:0.06em}}

/* ============ Floating scroll progress + back-to-top ============ */
.scroll-progress{position:fixed;bottom:32px;right:32px;width:52px;height:52px;z-index:100;opacity:0;transform:translateY(20px);transition:opacity .35s ease,transform .35s ease;cursor:pointer;border:none;padding:0;background:transparent;pointer-events:none;-webkit-tap-highlight-color:transparent}
.scroll-progress.is-visible{opacity:1;transform:translateY(0);pointer-events:auto}
.scroll-progress__ring{position:absolute;inset:0;width:100%;height:100%;transform:rotate(-90deg);overflow:visible}
.scroll-progress__track{fill:none;stroke:rgba(15,24,33,.08);stroke-width:2}
.scroll-progress__fill{fill:none;stroke:var(--c-blue);stroke-width:2;stroke-linecap:round;transition:stroke-dashoffset .12s linear}
.scroll-progress__button{position:absolute;inset:4px;background:rgba(255,255,255,.92);backdrop-filter:saturate(180%) blur(10px);-webkit-backdrop-filter:saturate(180%) blur(10px);border-radius:50%;display:flex;align-items:center;justify-content:center;color:var(--c-text-deep);transition:background .25s ease,color .25s ease,transform .25s ease;box-shadow:0 4px 16px -4px rgba(15,24,33,.12),0 2px 6px -2px rgba(15,24,33,.06)}
.scroll-progress:hover .scroll-progress__button{background:var(--c-blue);color:#fff;transform:scale(1.06)}
.scroll-progress:active .scroll-progress__button{transform:scale(0.96)}
.scroll-progress__button svg{width:16px;height:16px;display:block}
@media (max-width:768px){.scroll-progress{bottom:20px;right:20px;width:44px;height:44px}}



/* ============ AI Search — cover placeholder ============ */
.cs-cover-placeholder{
  width:100%; aspect-ratio:1140/560;
  background:
    radial-gradient(circle at 20% 25%, rgba(255,255,255,.85), rgba(255,255,255,0) 55%),
    radial-gradient(circle at 82% 72%, rgba(255,214,102,.5), rgba(255,214,102,0) 55%),
    linear-gradient(135deg, #E8F0FF 0%, #F5EEFF 45%, #FFF3E0 100%);
  border-radius:16px;
  display:flex; align-items:center; justify-content:center;
  position:relative;
}
.cs-cover-placeholder__inner{
  text-align:center; padding:0 40px; max-width:820px;
  display:flex; flex-direction:column; align-items:center;
}
.cs-cover-placeholder__eyebrow{
  font-size:13px; font-weight:700; letter-spacing:.24em;
  text-transform:uppercase; opacity:.5; margin-bottom:32px; color:#0F1821;
}
.cs-cover-placeholder__q-old{
  font-size:22px; font-weight:500; font-style:italic;
  opacity:.35; line-height:1.3; margin-bottom:10px; color:#0F1821;
}
.cs-cover-placeholder__arrow{
  font-size:20px; opacity:.32; margin:2px 0 8px; color:#0F1821;
}
.cs-cover-placeholder__q-new{
  font-size:56px; font-weight:900; line-height:1.08;
  letter-spacing:-.02em; color:#0F1821; margin-bottom:36px;
}
.cs-cover-placeholder__q-new em{
  font-style:normal;
  color:#0A66C2;
}
.cs-cover-placeholder__stages{
  font-size:14px; font-weight:700; opacity:.6;
  letter-spacing:.05em; text-transform:uppercase; color:#0F1821;
  margin-bottom:14px;
}
.cs-cover-placeholder__note{
  position:absolute; bottom:16px; right:20px;
  font-size:11px; font-weight:600; letter-spacing:.12em;
  text-transform:uppercase; opacity:.35; color:#0F1821;
}
@media (max-width:768px){
  .cs-cover-placeholder{ aspect-ratio:4/5; }
  .cs-cover-placeholder__q-new{ font-size:32px; }
  .cs-cover-placeholder__q-old{ font-size:16px; }
  .cs-cover-placeholder__stages{ font-size:11px; }
}

/* ============ Opening shifts list ============ */
.opening-shifts{
  list-style:none; padding:0; margin:8px 0 var(--gap-para);
  display:flex; flex-direction:column; gap:14px;
}
.opening-shifts li{
  font-size:17px; line-height:1.6; color:var(--c-body);
  padding-left:18px; position:relative;
}
.opening-shifts li::before{
  content:""; position:absolute; left:0; top:14px;
  width:6px; height:6px; border-radius:50%; background:var(--c-blue);
}
.opening-shifts li strong{ color:var(--c-text-deep); font-weight:700; }







/* ============ Opening lede — scene setter before the beats ============ */
.op-lede{
  font-size:22px; font-weight:500; line-height:1.55;
  color:var(--c-text-deep); letter-spacing:-.005em;
  margin:24px 0 8px;
  padding-bottom:32px;
  border-bottom:1px solid rgba(15,24,33,.08);
}
.op-lede em{
  font-style:italic; color:var(--c-text-deep);
}




/* ============ Opening — gateway before/after diagram ============ */
.op-gateway{
  display:grid; grid-template-columns:1fr 1fr; gap:20px;
  margin:28px 0 var(--gap-para);
  align-items:stretch;
}
.op-gw-panel{
  background:var(--c-container-bg); border-radius:16px;
  padding:24px 24px 22px;
  display:flex; flex-direction:column; gap:16px;
  border:1px solid rgba(15,24,33,.06);
}
.op-gw-panel--after{
  background:linear-gradient(180deg, #EFF5FE 0%, #E6EEFB 100%);
  border-color:rgba(10,102,194,.16);
}
.op-gw-eyebrow{
  font-size:11px; font-weight:800; letter-spacing:.22em;
  text-transform:uppercase; color:var(--c-body); opacity:.55;
}
.op-gw-panel--after .op-gw-eyebrow{ color:var(--c-blue); opacity:1; }
.op-gw-svg{ width:100%; height:auto; display:block; margin:auto 0; }
.op-gw-svg--before{ max-height:160px; }
.op-gw-svg--after{ max-height:280px; }
.op-gw-caption{
  font-size:13px; color:var(--c-body); line-height:1.5;
  margin:0; opacity:.85; font-style:italic;
}
@media (max-width:800px){ .op-gateway{ grid-template-columns:1fr; } }

/* ============ Opening — impact metrics ============ */
.op-metrics{
  display:grid; grid-template-columns:repeat(2, 1fr); gap:16px;
  margin:24px 0 var(--gap-para);
}
.op-metric{
  background:var(--c-container-bg); border-radius:14px;
  padding:24px 22px; display:flex; flex-direction:column; gap:8px;
  border-left:3px solid var(--c-blue);
}
.op-metric__value{
  font-size:38px; font-weight:900; color:var(--c-text-deep);
  letter-spacing:-.02em; line-height:1;
}
.op-metric__label{
  font-size:12px; font-weight:700; letter-spacing:.14em;
  text-transform:uppercase; color:var(--c-body); opacity:.7;
}
.op-metric__note{
  font-size:12px; color:var(--c-body); opacity:.6;
  font-style:italic; margin-top:2px;
}
@media (max-width:800px){ .op-metrics{ grid-template-columns:1fr; } }



/* ============ Opening — hero query (Ceiling's centerpiece) ============ */
.op-hero-query{
  margin:24px 0 var(--gap-para);
  padding:36px 40px 32px;
  background:linear-gradient(180deg, #FDF6E9 0%, #FCF0DB 100%);
  border-radius:20px;
  display:flex; flex-direction:column; gap:22px;
  border:1px solid rgba(176,128,20,.18);
}
.op-hero-query__eyebrow{
  font-size:11px; font-weight:800; letter-spacing:.24em;
  text-transform:uppercase; color:#B08014;
}
.op-hero-query__q{
  font-size:34px; font-weight:800; color:var(--c-text-deep);
  line-height:1.15; letter-spacing:-.015em; margin:0;
  font-style:italic;
}
.op-hero-query__q::before{
  content:"\201C"; opacity:.35; margin-right:2px;
}
.op-hero-query__q::after{
  content:"\201D"; opacity:.35; margin-left:2px;
}
.op-hero-query__gaps{
  display:grid; grid-template-columns:repeat(3, 1fr); gap:20px;
  margin-top:6px; padding-top:22px;
  border-top:1px solid rgba(176,128,20,.22);
}
.op-hero-query__gap{
  display:flex; flex-direction:column; gap:6px;
}
.op-hero-query__gap-label{
  font-size:10px; font-weight:800; letter-spacing:.16em;
  text-transform:uppercase; color:#8B6414; opacity:.85;
}
.op-hero-query__gap-value{
  font-size:20px; font-weight:800; color:var(--c-text-deep);
  line-height:1.2; letter-spacing:-.01em;
}
.op-hero-query__gap-value em{
  font-style:normal; color:#0A66C2;
}
.op-hero-query__gap-note{
  font-size:13px; color:var(--c-body); opacity:.75;
  line-height:1.4; font-style:italic;
}
@media (max-width:720px){
  .op-hero-query{ padding:28px 24px; }
  .op-hero-query__q{ font-size:24px; }
  .op-hero-query__gaps{ grid-template-columns:1fr; gap:16px; padding-top:18px; }
}

/* ============ Opening — sub-beat labels ============ */
.op-beat{ margin-top:56px; }
.op-beat:first-of-type{ margin-top:24px; }
.op-beat__label{
  display:flex; align-items:center; gap:14px;
  font-size:12px; font-weight:800; letter-spacing:.22em;
  text-transform:uppercase; color:var(--c-blue);
  margin:0 0 20px;
}
.op-beat__label::before{
  content:""; width:36px; height:2px; background:var(--c-blue);
}
.op-beat__label-num{
  color:var(--c-blue); opacity:.55; font-weight:700;
}

/* ============ Opening viz — 1. two-query contrast ============ */
.op-queries{
  display:grid; grid-template-columns:1fr 1fr; gap:0;
  margin:16px 0 var(--gap-para);
  border-top:1px solid rgba(15,24,33,.10);
  border-bottom:1px solid rgba(15,24,33,.10);
}
.op-query{
  padding:28px 4px;
  display:flex; flex-direction:column; gap:12px;
  position:relative;
}
.op-query--left{ padding-right:32px; }
.op-query--right{
  padding-left:32px;
  border-left:1px solid rgba(15,24,33,.10);
}
.op-query__label{
  font-size:10px; font-weight:800; letter-spacing:.22em;
  text-transform:uppercase;
}
.op-query--left .op-query__label{ color:#2A9D5C; }
.op-query--right .op-query__label{ color:#B08014; }
.op-query__q{
  font-size:22px; font-weight:700; color:var(--c-text-deep);
  line-height:1.3; letter-spacing:-.01em; margin:0;
}
.op-query__q::before{
  content:"\201C"; color:var(--c-body); opacity:.35;
  margin-right:1px;
}
.op-query__q::after{
  content:"\201D"; color:var(--c-body); opacity:.35;
  margin-left:1px;
}
.op-query__outcome{
  font-size:14px; color:var(--c-body); line-height:1.55;
  margin:4px 0 0;
}
.op-query__outcome strong{ color:var(--c-text-deep); font-weight:700; }
@media (max-width:720px){
  .op-queries{ grid-template-columns:1fr; }
  .op-query--left{ padding:0 0 24px; border-bottom:1px solid rgba(15,24,33,.10); }
  .op-query--right{ padding:24px 0 0; border-left:none; }
}

/* ============ Opening viz — 2. three capability shift cards ============ */
.op-shifts-viz{
  display:grid; grid-template-columns:repeat(3,1fr); gap:16px;
  margin:12px 0 var(--gap-para);
}
.op-shift{
  background:#fff;
  border:1px solid rgba(15,24,33,.09);
  border-radius:14px; padding:22px 22px 24px;
  display:flex; flex-direction:column; gap:14px;
  transition:transform .3s cubic-bezier(.4,0,.2,1), box-shadow .3s;
}
.op-shift:hover{ transform:translateY(-3px); box-shadow:0 12px 32px -12px rgba(15,24,33,.12); }
.op-shift__arrow{
  display:flex; align-items:center; gap:8px;
  font-size:11px; font-weight:700; letter-spacing:.08em;
  text-transform:uppercase; color:var(--c-body);
}
.op-shift__from{ color:var(--c-body); opacity:.55; }
.op-shift__to{ color:var(--c-blue); }
.op-shift__arrow-sep{ opacity:.35; margin:0 2px; }
.op-shift__title{
  font-size:19px; font-weight:800; color:var(--c-text-deep);
  letter-spacing:-.005em; line-height:1.25;
}

.op-shift__title em{
  font-style:normal; color:var(--c-blue); font-weight:800;
}
.op-shift__desc{
  font-size:14px; line-height:1.55; color:var(--c-body); margin:0;
}
@media (max-width:900px){ .op-shifts-viz{ grid-template-columns:1fr; } }

/* ============ Opening viz — 3. three staged bets roadmap ============ */
.op-roadmap{
  position:relative;
  margin:32px 0 var(--gap-para);
  padding:20px 8px 0;
}
/* horizontal connector line running through the number circles */
.op-roadmap__line{
  position:absolute; top:52px; left:12%; right:12%; height:2px;
  background:repeating-linear-gradient(90deg, rgba(10,102,194,.35) 0 8px, transparent 8px 14px);
  z-index:0;
}
.op-roadmap__row{
  display:grid; grid-template-columns:repeat(3, 1fr); gap:24px;
  position:relative; z-index:1;
}
.op-node{
  display:flex; flex-direction:column; align-items:center; gap:18px;
}
.op-node__num{
  width:64px; height:64px; border-radius:50%;
  background:#fff; border:2px solid var(--c-blue);
  display:flex; align-items:center; justify-content:center;
  font-size:20px; font-weight:800; color:var(--c-blue);
  letter-spacing:.02em;
  box-shadow:0 0 0 6px rgba(10,102,194,.06);
  position:relative;
}
.op-node__num::after{
  content:""; position:absolute; inset:-2px;
  border-radius:50%; border:2px solid transparent;
  transition:border-color .3s ease;
}
.op-node:hover .op-node__num::after{ border-color:var(--c-blue); }
.op-node__proj{
  font-size:11px; font-weight:800; letter-spacing:.16em;
  text-transform:uppercase; color:var(--c-blue);
  padding:6px 12px; border-radius:20px;
  background:rgba(10,102,194,.08);
  margin-top:-4px;
}
.op-node__q{
  font-size:15px; font-weight:600; color:var(--c-text-deep);
  line-height:1.4; text-align:center;
  max-width:260px; margin:-4px 0 0;
}

.op-node__sub{
  font-size:13px; color:var(--c-body); line-height:1.5;
  text-align:center; max-width:260px; margin:2px 0 0;
  opacity:.75; font-style:italic;
}
.op-roadmap__arc{
  display:flex; align-items:center; justify-content:center;
  gap:18px; margin:32px 0 0;
  font-size:12px; font-weight:800; letter-spacing:.22em;
  text-transform:uppercase; color:var(--c-blue); opacity:.7;
}
.op-roadmap__arc span{ display:inline-block; }
.op-roadmap__arc-sep{ opacity:.4; font-weight:400; }

.op-node__proj-full{
  font-size:15px; font-weight:800; color:var(--c-text-deep);
  letter-spacing:-.005em; text-align:center;
  margin:2px 0 0;
}
.op-node__status{
  display:inline-flex; align-items:center; gap:5px;
  font-size:10px; font-weight:800; letter-spacing:.14em; text-transform:uppercase;
  color:#2A9D5C;
}
.op-node__status::before{
  content:""; width:6px; height:6px; border-radius:50%; background:#2A9D5C;
}
@media (max-width:800px){
  .op-roadmap__row{ grid-template-columns:1fr; gap:32px; }
  .op-roadmap__line{ display:none; }
}


/* ============ Opening pull-quote ============ */
.opening-quote{
  margin:36px auto 44px;
  max-width:760px;
  padding:0 8px;
  display:flex; flex-direction:column; align-items:flex-start;
  gap:14px;
  font-style:normal;
  position:relative;
}
.opening-quote__eyebrow{
  font-size:11px; font-weight:800; letter-spacing:.22em;
  text-transform:uppercase; color:var(--c-blue);
  display:flex; align-items:center; gap:12px;
}
.opening-quote__eyebrow::before{
  content:""; width:32px; height:2px; background:var(--c-blue);
}
.opening-quote__body{
  position:relative; padding-left:28px;
  font-size:26px; font-weight:700; line-height:1.35;
  letter-spacing:-.01em; color:var(--c-text-deep);
}
.opening-quote__body::before{
  content:""; position:absolute; left:0; top:6px; bottom:6px;
  width:3px; background:var(--c-blue); border-radius:2px;
}
.opening-quote__body em{
  font-style:normal; font-weight:900; color:var(--c-blue);
  letter-spacing:-.005em;
}
@media (max-width:720px){
  .opening-quote__body{ font-size:20px; padding-left:20px; }
}

/* ============ Cover ============ */
.cs-cover{max-width:var(--container-width);margin:16px auto 0}
.cs-cover img{width:100%;height:auto}

/* ============ Heading hierarchy ============ */
.l1{font-family:var(--font-sans);font-weight:400;font-size:56px;color:var(--c-l1);margin:var(--gap-l1-top) 0 var(--gap-l1-bottom);letter-spacing:-0.01em;line-height:1.1;padding-top:32px;position:relative}
.l1::before{content:"";position:absolute;top:0;left:0;width:64px;height:4px;background:var(--c-blue);border-radius:2px}
.l2{font-family:var(--font-sans);font-weight:700;font-size:22px;color:var(--c-text-deep);margin:var(--gap-l2-top) 0 var(--gap-l2-bottom);line-height:1.35;letter-spacing:-0.002em}
.l3,.text-img__copy h3.l3{font-family:var(--font-sans);font-weight:700;font-size:18px;color:var(--c-text-deep);margin:0 0 12px;line-height:1.35;letter-spacing:-0.002em}
.l3--blue,.text-img__copy h3.l3--blue{color:var(--c-blue)}                                                                                          /* Goals: blue variant */
.l1 + .l2{margin-top:0}                                /* L2 right after L1: tighten */

/* Body text — inherits Airbnb Cereal Light 18px #464545 from body */
.p{margin:0 0 var(--gap-para);font-weight:400;color:var(--c-body);line-height:1.7;font-size:17px}
.p--muted{color:var(--c-body)}              /* alias kept for backward compat */
.p strong{color:var(--c-blue);font-weight:700}                  /* inline blue bold (#0A66C2) */
.p strong.dark{color:var(--c-text-deep);font-weight:700}
.p strong.deep{color:var(--c-blue);font-weight:700}

/* Generic block spacing */
.block{margin-bottom:var(--gap-section-block)}

/* ============ Intro: Design by accretion + meta box ============ */
.cs-meta-box{background:var(--c-meta-bg);border-radius:20px;padding:56px 64px;margin:32px auto var(--gap-section-block);max-width:var(--container-width);display:grid;grid-template-columns:1fr 1fr;gap:48px}
.cs-meta-col{display:flex;flex-direction:column;gap:8px}
.cs-meta-h{font-size:16px;font-weight:700;color:var(--c-text-deep);margin:24px 0 8px;letter-spacing:0.02em}
.cs-meta-h:first-child{margin-top:0}
.cs-meta-p{font-size:16px;line-height:1.6;color:var(--c-body);margin:0 0 8px;font-weight:400}
.cs-meta-list{list-style:disc;padding-left:22px;margin:0;font-size:16px;line-height:1.8;color:var(--c-body);font-weight:400}

/* Skip hint — inline pill (contextual, sits after mini-program explanation) */
.skip-inline{display:inline-flex;align-items:center;gap:12px;padding:12px 20px 12px 16px;background:var(--c-container-bg);border-radius:999px;font-size:14px;color:var(--c-body);margin:24px 0 8px;font-weight:400;line-height:1.4}
.skip-inline__icon{display:inline-flex;align-items:center;color:var(--c-blue);flex-shrink:0}
.skip-inline__icon svg{width:16px;height:16px;display:block}
.skip-inline a{color:var(--c-blue);font-weight:700;text-decoration:none;border-bottom:1px solid transparent;transition:border-color .2s ease;white-space:nowrap}
.skip-inline a:hover{border-bottom-color:currentColor}

/* ============ Light blue stats callout (with right + bottom blue borders) ============ */
.callout-blue{background:var(--c-container-bg);border-radius:20px;padding:40px 48px;max-width:var(--container-width);margin:32px 0 56px}
.callout-blue h4{font-size:12px;font-weight:700;color:var(--c-blue);letter-spacing:0.2em;text-transform:uppercase;margin:0 0 20px}
.callout-blue ul{list-style:none;padding:0;margin:0;font-size:17px;line-height:1.7;color:var(--c-body);font-weight:400}
.callout-blue li{margin:0 0 12px;padding-left:24px;position:relative}
.callout-blue li::before{content:"";position:absolute;left:0;top:9px;width:6px;height:6px;background:var(--c-blue);border-radius:50%}

/* ============ 2-col captioned (Notification + Viral) ============ */
.two-col{display:grid;grid-template-columns:1fr 1fr;gap:64px;max-width:var(--container-width);margin:var(--gap-text-to-img) auto var(--gap-img-to-text);align-items:start}
.two-col__item{text-align:center}
.two-col__title{font-size:22px;font-weight:700;color:var(--c-text-deep);margin:0 0 var(--gap-caption-to-img)}
.two-col__item{display:flex;flex-direction:column;align-items:center}
.two-col__title{margin:0 0 20px}
.two-col__img-box{width:100%;height:280px;min-height:280px;display:flex;align-items:center;justify-content:center}
.two-col__item img{display:block;max-width:100%;max-height:280px;width:auto;height:auto;margin:0 auto}

/* ============ Generic image block ============ */
.img{margin:var(--gap-text-to-img) auto var(--gap-img-to-text);text-align:center;max-width:var(--container-width)}
.img img{display:inline-block;max-width:720px;width:100%;height:auto}
.img--wide{max-width:1424px}
.img--wide img{max-width:1424px}
.img--full{max-width:var(--container-width)}
.img--full img{max-width:100%}
.img__caption{font-size:12px;font-weight:700;color:var(--c-body);text-align:center;letter-spacing:0.2em;text-transform:uppercase;margin:0 0 var(--gap-caption-to-img);font-family:var(--font-sans)}
.img__caption--blue{color:var(--c-blue)}

/* Findings nested bullet list */
.findings-list{list-style:disc;padding-left:24px;margin:0;font-size:18px;line-height:1.7;color:var(--c-body);font-weight:400}
.findings-list > li{margin:0 0 14px}
.findings-list ul{list-style:circle;padding-left:24px;margin:6px 0 0;font-size:17px}
.findings-list ul li{margin:0 0 4px}

/* ============ Why redesign container ============ */
.why-container{background:var(--c-container-bg);border-radius:20px;padding:48px 56px;margin:var(--gap-text-to-img) auto 0;max-width:var(--container-width)}
.why-container ul{list-style:disc;padding-left:24px;margin:0 0 32px;font-size:17px;line-height:1.7;color:var(--c-body);font-weight:400}
.why-container li{margin:0 0 16px}
.why-container li:last-child{margin-bottom:0}
.why-container .quotes{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin:24px 0 32px}
.quote-card{background:#fff;border-radius:16px;padding:36px 32px 28px;font-size:16px;line-height:1.6;color:var(--c-text-deep);position:relative;font-weight:400;display:flex;flex-direction:column;justify-content:space-between;box-shadow:0 4px 16px -8px rgba(15,24,33,.10),0 1px 3px -1px rgba(15,24,33,.05);border:1px solid rgba(15,24,33,.04)}
.quote-card::before{content:"";position:absolute;top:0;left:32px;width:32px;height:3px;background:var(--c-blue);border-radius:0 0 2px 2px}
.quote-card p{margin:0 0 20px;font-style:italic;position:relative;z-index:1}
.quote-card__attribution{font-size:11px;font-weight:700;color:var(--c-body);letter-spacing:0.18em;text-transform:uppercase;margin:0;font-style:normal;opacity:0.65}

/* Down arrow */
.arrow-down{display:flex;justify-content:center;margin:48px auto}
.arrow-down svg{width:48px;height:auto}

/* Centered bold blue highlight */
.highlight-center{text-align:center;font-size:22px;font-weight:700;color:var(--c-blue);max-width:1000px;margin:24px auto var(--gap-section-block);line-height:1.45}

/* ============ Step blocks (editorial subsection treatment for long L1 sections) ============ */
.step-block{margin:128px 0 0;position:relative}
.step-block:first-of-type{margin-top:40px}
.step-block:not(:first-of-type)::before{content:"";position:absolute;top:-64px;left:0;width:40px;height:2px;background:var(--c-blue);opacity:0.3;border-radius:2px}
.step-block__overline{font-size:11px;font-weight:700;color:var(--c-blue);letter-spacing:0.24em;text-transform:uppercase;margin:0 0 12px}
.step-block__title{font-size:26px;font-weight:700;color:var(--c-text-deep);margin:0 0 20px;line-height:1.25;letter-spacing:-0.005em;font-family:var(--font-sans)}
.step-block__body p{font-size:17px;line-height:1.7;color:var(--c-body);margin:0 0 16px;font-weight:400}
.step-block__body p:last-child{margin-bottom:0}
.step-block__body p strong{color:var(--c-blue);font-weight:700}

/* ============ Challenge blocks (editorial chapter treatment) ============ */
.challenge-block{margin:64px 0 0;padding-top:32px;border-top:1px solid rgba(15,24,33,.08);position:relative}
.challenge-block:first-of-type{margin-top:32px;padding-top:0;border-top:none}
.challenge-block__overline{font-size:12px;font-weight:700;color:var(--c-blue);letter-spacing:0.2em;text-transform:uppercase;margin:0 0 12px}
.challenge-block__title{font-size:26px;font-weight:700;color:var(--c-text-deep);margin:0 0 20px;line-height:1.25;letter-spacing:-0.005em;font-family:var(--font-sans)}
.challenge-block__body p{font-size:17px;line-height:1.75;color:var(--c-body);margin:0 0 16px;font-weight:400}
.challenge-block__body p:last-child{margin-bottom:0}
.challenge-block__body p strong{color:var(--c-blue);font-weight:700}

/* ============ Emoji bullet list (Vague direction) ============ */
.emoji-list{list-style:none;padding:0 0 0 64px;margin:8px 0 0;max-width:var(--container-width)}
.emoji-list li{font-size:18px;line-height:1.7;color:var(--c-body);margin:0 0 16px;font-weight:400}
.emoji-list strong{color:var(--c-text-deep);font-weight:700}
.q-mark{color:var(--c-blue);font-weight:700}



/* ============ Testing Plan card (document-style visual) ============ */
.testing-plan-card{background:#fff;border:1px solid rgba(15,24,33,.08);border-radius:16px;padding:32px 32px 28px;width:100%;display:flex;flex-direction:column;gap:20px;box-shadow:0 8px 24px -12px rgba(15,24,33,.10),0 2px 6px -2px rgba(15,24,33,.04)}
.testing-plan-card__stamp{font-size:10px;font-weight:700;color:var(--c-blue);letter-spacing:0.24em;text-transform:uppercase;margin:0;font-family:var(--font-sans)}
.testing-plan-card__title{font-size:17px;font-weight:700;color:var(--c-text-deep);margin:0;line-height:1.35;letter-spacing:-0.003em;font-family:var(--font-sans)}
.testing-plan-card__meta{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;padding:16px 0;border-top:1px solid rgba(15,24,33,.06);border-bottom:1px solid rgba(15,24,33,.06)}
.testing-plan-card__meta > div{text-align:left}
.tp-meta-num{font-family:var(--font-sans);font-size:26px;font-weight:800;color:var(--c-text-deep);line-height:1;letter-spacing:-0.02em;margin:0 0 4px}
.tp-meta-num span{font-size:11px;font-weight:600;color:var(--c-body);margin-left:2px}
.tp-meta-label{font-size:10.5px;font-weight:600;color:var(--c-body);letter-spacing:0.06em;text-transform:uppercase;margin:0}
.testing-plan-card__sections{display:flex;flex-direction:column;gap:10px}
.tp-section{display:flex;gap:14px;align-items:center;padding:12px 14px;background:var(--c-callout-blue);border-radius:10px}
.tp-section__label{width:24px;height:24px;flex-shrink:0;border-radius:6px;background:var(--c-blue);color:#fff;font-family:var(--font-sans);font-size:12px;font-weight:700;display:flex;align-items:center;justify-content:center;margin:0}
.tp-section__body{font-size:13.5px;line-height:1.4;color:var(--c-text-deep);font-weight:500;margin:0}

/* ============ Research Goals — 2 stacked mini-cards ============ */
.goals-grid{display:flex;flex-direction:column;gap:12px}
.goals-card{background:var(--c-container-bg);border-radius:12px;padding:20px 24px}
.goals-card__section{font-size:12px;font-weight:700;color:var(--c-blue);letter-spacing:0.18em;text-transform:uppercase;margin:0 0 12px;font-family:var(--font-sans)}
.goals-card ul.goals-card__list{list-style:none !important;padding:0;margin:0}
.goals-card__list li{position:relative;padding-left:16px;font-size:14px;line-height:1.6;color:var(--c-body);margin:0 0 6px;font-weight:400}
.goals-card__list li:last-child{margin-bottom:0}
.goals-card__list li::before{content:"";position:absolute;left:0;top:8px;width:4px;height:4px;background:var(--c-blue);border-radius:50%;opacity:0.7}


/* ============ Findings 3-card grid (results validation blocks) ============ */
.findings-grid{display:grid;grid-template-columns:1fr 1fr 1fr;gap:20px;max-width:var(--container-width);margin:32px auto 0}
.findings-card{background:var(--c-container-bg);border-radius:16px;padding:28px 28px 24px;display:flex;flex-direction:column;gap:14px}
.findings-card__num{font-size:11px;font-weight:700;color:var(--c-blue);letter-spacing:0.22em;text-transform:uppercase;margin:0;font-family:var(--font-sans)}
.findings-card__title{font-size:16px;font-weight:700;color:var(--c-text-deep);margin:0;line-height:1.4;font-family:var(--font-sans);letter-spacing:-0.003em;display:flex;flex-wrap:wrap;gap:8px;align-items:baseline}
.findings-card__tag{display:inline-block;font-size:10px;font-weight:700;color:var(--c-blue);background:var(--c-callout-blue);padding:3px 8px;border-radius:999px;letter-spacing:0.06em;text-transform:uppercase;font-family:var(--font-sans)}
.findings-card__list{list-style:none;padding:0;margin:0}
.findings-card__list li{position:relative;padding-left:16px;font-size:13.5px;line-height:1.55;color:var(--c-body);margin:0 0 8px;font-weight:400}
.findings-card__list li:last-child{margin-bottom:0}
.findings-card__list li::before{content:"";position:absolute;left:0;top:8px;width:4px;height:4px;background:var(--c-blue);border-radius:50%;opacity:0.7}
.findings-card__list li em{font-style:italic;color:var(--c-body);opacity:0.85}
@media (max-width:900px){.findings-grid{grid-template-columns:1fr 1fr}}
@media (max-width:600px){.findings-grid{grid-template-columns:1fr}}

/* ============ Sub-overline (unified small heading for text-img sub-topics) ============ */
.sub-overline{font-size:11px;font-weight:700;color:var(--c-blue);letter-spacing:0.22em;text-transform:uppercase;margin:0 0 16px;font-family:var(--font-sans)}

/* ============ UNIFIED CALLOUT SYSTEM (Opportunities · Pain points · Stakeholders) ============
   Shared design tokens: soft-blue container / 20px radius / 40px 48px padding /
   overline 11px UPPERCASE 0.22em / card title 18px / body 14-15px / max-width 1140px */
.uc-block{background:var(--c-callout-blue);border-radius:20px;padding:40px 48px;margin:32px auto 0;max-width:var(--container-width)}
.uc-overline{font-size:11px;font-weight:700;color:var(--c-blue);letter-spacing:0.22em;text-transform:uppercase;margin:0 0 20px;font-family:var(--font-sans)}
.uc-title{font-size:18px;font-weight:700;color:var(--c-text-deep);margin:0 0 12px;line-height:1.35;font-family:var(--font-sans);letter-spacing:-0.003em}
.uc-body{font-size:14.5px;line-height:1.65;color:var(--c-body);margin:0;font-weight:400}
.uc-body strong{color:var(--c-text-deep);font-weight:700}
.uc-list{list-style:none;padding:0;margin:0}
.uc-list li{position:relative;padding-left:18px;font-size:14.5px;line-height:1.65;color:var(--c-body);margin:0 0 10px;font-weight:400}
.uc-list li:last-child{margin-bottom:0}
.uc-list li::before{content:"";position:absolute;left:0;top:9px;width:5px;height:5px;background:var(--c-blue);border-radius:50%;opacity:0.75}

/* --- Opportunities: single narrow callout, centered rhythm --- */
.uc-opportunities{max-width:820px;margin-left:0;margin-right:auto}
.uc-opportunities .uc-list li{font-size:15.5px;line-height:1.7;margin-bottom:8px}
.uc-opportunities .uc-list li strong{color:var(--c-blue)}

/* --- Pain points: 2×2 grid, cards nested inside a wrapping frame --- */
.uc-painpoints{padding:24px;background:transparent}
.uc-painpoints-grid{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.uc-painpoints-card{background:var(--c-callout-blue);border-radius:16px;padding:28px 32px}
.uc-painpoints-card .uc-overline{margin:0 0 8px}
.uc-painpoints-card .uc-title{font-size:18px;margin:0 0 14px}
.uc-painpoints-card .uc-list li{font-size:14px;margin-bottom:8px}
@media (max-width:768px){.uc-painpoints-grid{grid-template-columns:1fr}}

/* --- Stakeholders: 3 rows, label-left, description-right, uniform blue with dividers --- */
.uc-stakeholders{padding:8px 40px}
.uc-stake-row{display:grid;grid-template-columns:180px 1fr;gap:32px;padding:22px 0;border-bottom:1px solid rgba(15,24,33,.08);align-items:center}
.uc-stake-row:last-child{border-bottom:none}
.uc-stake-row__label{font-size:12px;font-weight:700;color:var(--c-blue);letter-spacing:0.2em;text-transform:uppercase;margin:0;font-family:var(--font-sans)}
.uc-stake-row__body{font-size:15px;line-height:1.6;color:var(--c-body);margin:0;font-weight:400}
.uc-stake-row__body strong{color:var(--c-text-deep);font-weight:700}
@media (max-width:768px){.uc-stakeholders{padding:8px 24px}.uc-stake-row{grid-template-columns:1fr;gap:6px;padding:18px 0}}

/* --- Design Goal card: soften proportions, align with system --- */
.design-goal-card{padding:48px 64px !important;min-height:280px !important}
.design-goal-card__circle{width:200px !important;height:200px !important;left:80px !important;opacity:0.9 !important}
.design-goal-card__copy{margin-left:160px !important;padding:16px 0 !important}
.design-goal-card__copy h3{font-size:11px !important;letter-spacing:0.22em !important;margin:0 0 16px !important}
.design-goal-card__copy ul{font-size:16px !important;line-height:1.85 !important;font-weight:400 !important}


/* ============ Pain-point circles (UER research findings — 3-top + 2-bot layout) ============ */
.pain-circles{display:flex;flex-direction:column;gap:10px;max-width:480px;margin:0 auto;align-items:center}
.pain-circles__row{display:flex;justify-content:center;gap:16px}
.pain-circles__row--bot{padding:0 78px}
.pain-circle{width:144px;height:144px;border-radius:50%;overflow:hidden;background:#F1F3F5;box-shadow:0 4px 14px -6px rgba(15,24,33,.15);display:flex;flex-direction:column}
.pain-circle__top{flex:1;display:flex;align-items:center;justify-content:center;padding:12px 14px}
.pain-circle__top span{font-size:11.5px;line-height:1.35;color:#4A5868;text-align:center;font-weight:500;font-family:var(--font-sans)}
.pain-circle__bot{height:34px;background:var(--c-blue);color:#fff;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:700;letter-spacing:0.05em;font-family:var(--font-sans)}
@media (max-width:900px){.pain-circles{max-width:100%}.pain-circles__row{flex-wrap:wrap}.pain-circles__row--bot{padding:0}.pain-circle{width:120px;height:120px}}

/* ============ How I got there: complex layouts ============ */
/* Pain points: text-LEFT + image-RIGHT */
.text-img{display:grid;grid-template-columns:5fr 6fr;gap:64px;max-width:var(--container-width);margin:var(--gap-l2-top) auto var(--gap-l2-top);align-items:start}
.text-img__copy .l2{margin-top:0}                   /* heading inside text group: no top margin */
.l2 + .text-img{margin-top:var(--gap-l2-bottom)}    /* if L2 is right above .text-img: tighten to 16px (L2 already gave 80px above) */
.text-img--tight{margin-top:24px;margin-bottom:32px}/* tight variant for L3-level paired sections (Methodology, Goals) */
.text-img--imgleft .text-img__media{order:0}
.text-img--imgleft .text-img__copy{order:1}
.text-img__copy h3{font-size:24px;font-weight:700;color:var(--c-text-deep);margin:0 0 var(--gap-l2-bottom)}
.text-img__copy h3.l2{font-size:22px !important;font-weight:700;letter-spacing:-0.002em}
.text-img__copy .blue-label{color:var(--c-blue);font-size:18px;margin:0 0 12px}
.text-img__copy ul{list-style:disc;padding-left:22px;margin:8px 0 0;font-size:18px;line-height:1.7;color:var(--c-body)}
.text-img__copy p{font-size:18px;line-height:1.6;color:var(--c-body);margin:0 0 14px;font-weight:400}
.text-img__media img{width:100%;height:auto}
.text-img__media{text-align:center}
.text-img__media img.fixed-w{width:auto;max-width:100%}
.img-caption-below{font-size:16px;font-weight:400;color:var(--c-body);text-align:center;margin:16px auto 0;font-family:var(--font-sans)}

/* Design Goal — light blue card with half-blue/half-white circle, all in HTML/CSS */
.design-goal-card{background:var(--c-container-bg);border-radius:20px;padding:64px 80px;position:relative;margin:var(--gap-section-block) auto 0;max-width:var(--container-width);min-height:340px;overflow:hidden}
.design-goal-card__circle{position:absolute;left:96px;top:50%;transform:translateY(-50%);width:240px;height:240px;border-radius:50%;background:linear-gradient(to right,var(--c-blue) 50%,var(--c-callout-blue) 50%);z-index:0;opacity:0.85}
.design-goal-card__copy{position:relative;margin-left:200px;padding:24px 0;z-index:1}
.design-goal-card__copy h3{font-size:12px;font-weight:700;color:var(--c-blue);letter-spacing:0.2em;text-transform:uppercase;margin:0 0 20px;font-family:var(--font-sans)}
.design-goal-card__copy ul{list-style:disc;padding-left:24px;margin:0;font-size:18px;line-height:1.95;color:var(--c-body);font-weight:400}
.design-goal-card__copy li{margin:0 0 4px}

/* ============ Design Principles 4-grid ============ */
.principles{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;max-width:var(--container-width);margin:var(--gap-text-to-img) auto var(--gap-section-block);counter-reset:principle}
.principles__item{position:relative;background:#F9FAFB;border-radius:16px;padding:32px 28px 28px;text-align:left;display:flex;flex-direction:column;gap:14px;counter-increment:principle;transition:transform .3s ease,box-shadow .3s ease}
.principles__item:hover{transform:translateY(-3px);box-shadow:0 12px 28px -14px rgba(15,24,33,.15)}
.principles__item::before{content:"Principle 0" counter(principle);position:absolute;top:24px;right:28px;font-family:var(--font-sans);font-size:10px;font-weight:700;color:var(--c-blue);letter-spacing:0.22em;text-transform:uppercase}
.principles__item img{width:72px;height:72px;margin:0 0 4px;border-radius:0;background:transparent;object-fit:contain}
@media (max-width:900px){.principles{grid-template-columns:1fr;gap:16px}}
.principles__item h4{font-size:20px;font-weight:700;color:var(--c-blue);margin:0 0 8px}
.principles__item p{font-size:14px;line-height:1.65;color:var(--c-body);margin:0;font-weight:400;text-align:left}

/* ============ Personas/circles 5-pain points (handled as image y=7044) ============ */
/* Already covered by .text-img */

/* ============ Tips/Reflections list ============ */
.bullet-list{list-style:disc;padding-left:24px;margin:8px 0 0;font-size:18px;line-height:1.7;color:var(--c-body);max-width:var(--container-width);font-weight:400}
.bullet-list li{margin:0 0 12px}

/* ============ Data highlight badges (inline stat callouts) ============ */
.stat{display:inline-block;padding:1px 8px;border-radius:6px;font-weight:700;font-variant-numeric:tabular-nums;font-size:14px;letter-spacing:-0.005em}
.stat--up{background:rgba(10,102,194,.10);color:var(--c-blue)}
.stat--down{background:rgba(10,102,194,.10);color:var(--c-blue)}
.stat--flat{background:rgba(15,24,33,.06);color:var(--c-text-deep);font-weight:600}

/* ============ Results metric cards (matches dingtalk hero-number pattern) ============ */
/* Results core-metrics flow (data → implications with subtle arrow) */
.results-flow__caption{text-align:left;font-family:var(--font-sans);font-size:11px;font-weight:700;color:var(--c-blue);margin:32px 0 16px;letter-spacing:0.24em;text-transform:uppercase}
.results-flow{display:grid;grid-template-columns:1fr 32px 1fr;gap:16px;align-items:center;margin:0 0 32px}
.results-flow__card{background:var(--c-container-bg);border-radius:16px;padding:28px 32px}
.results-flow__card--blue{background:var(--c-callout-blue)}
.results-flow__card ul{list-style:none;padding:0;margin:0}
.results-flow__card li{position:relative;padding-left:18px;font-size:15px;line-height:1.65;color:var(--c-body);margin:0 0 14px;font-weight:400}
.results-flow__card li:last-child{margin-bottom:0}
.results-flow__card li::before{content:"";position:absolute;left:0;top:9px;width:4px;height:4px;background:var(--c-body);border-radius:50%;opacity:0.5}
.results-flow__card--blue li::before{background:var(--c-blue);opacity:1}
.results-flow__card li strong{color:var(--c-text-deep);font-weight:700}
.results-flow__card--blue li strong{color:var(--c-blue)}
.results-flow__note{font-style:italic;opacity:0.6;font-size:13px}
.results-flow__arrow{display:flex;align-items:center;justify-content:center;color:var(--c-blue);width:32px;height:32px}
.results-flow__arrow svg{width:20px;height:20px;display:block}
@media (max-width:768px){.results-flow{grid-template-columns:1fr;gap:12px}.results-flow__arrow{transform:rotate(90deg);margin:0 auto}}

/* ============ Framework visualization (3-column: annotations + phone + text) ============ */
.framework-viz{display:grid;grid-template-columns:1fr 260px 1fr;gap:20px;align-items:start;max-width:var(--container-width);margin:32px 0 0}
.framework-viz__annos{position:relative;height:540px}
.framework-viz__anno{position:absolute;right:0;width:100%;display:flex;flex-direction:row-reverse;gap:14px;align-items:center;text-align:right}
.framework-viz__anno-bar{width:3px;flex-shrink:0;background:var(--c-blue);border-radius:2px;align-self:stretch}
.framework-viz__anno p{margin:0;font-size:14px;line-height:1.5;color:var(--c-blue);font-weight:500;padding-left:20px}
/* Bars span the visible height of each phone section; text vertical-center aligned with bar */
.framework-viz__anno--banner{top:78px;height:80px}
.framework-viz__anno--mentor{top:166px;height:96px}
.framework-viz__anno--qa{top:270px;height:200px}
.framework-viz__text{padding-top:220px}
.framework-viz__phone{display:flex;justify-content:center}
.framework-viz__phone-frame{width:260px;height:540px;background:#fff;border-radius:32px;padding:8px 10px;box-shadow:0 20px 40px -20px rgba(15,24,33,.12),0 4px 12px -4px rgba(15,24,33,.06);border:1.5px solid rgba(15,24,33,.14);display:flex;flex-direction:column;position:relative;overflow:hidden}
.framework-viz__statusbar{display:flex;align-items:center;justify-content:space-between;padding:4px 8px 6px;font-size:10px;color:var(--c-text-deep);font-weight:600}
.framework-viz__statusbar-icons{display:inline-flex;gap:4px;align-items:center;color:var(--c-text-deep)}
.framework-viz__statusbar-icons svg{width:auto;height:9px;display:block}
.framework-viz__phone-header{text-align:center;font-size:12px;font-weight:600;color:var(--c-text-deep);padding:2px 0 8px;border-bottom:1px solid rgba(15,24,33,.08);margin-bottom:8px}
.framework-viz__phone-body{display:flex;flex-direction:column;gap:8px;flex:1;overflow:hidden}
.framework-viz__phone-section{background:#F4F5F7;border-radius:10px;padding:12px;display:flex;flex-direction:column;gap:8px}
.framework-viz__phone-section--banner{min-height:80px;background:transparent;padding:0;position:relative;display:flex;align-items:stretch;justify-content:center;gap:6px;overflow:hidden}
.framework-viz__banner-slide{flex:0 0 78%;background:#E4E7EC;border-radius:10px;display:flex;align-items:center;justify-content:center;position:relative}
.framework-viz__banner-slide--peek{flex:0 0 6%;background:#EAECEF;border-radius:6px;opacity:0.7}
.framework-viz__phone-section--qa{flex:1}
.framework-viz__phone-section p{font-size:11px;color:var(--c-text-deep);font-weight:700;margin:0}
.framework-viz__banner-icon{width:36px;height:24px;background:#D3D9DE;border-radius:4px}
.framework-viz__progress-dot{position:absolute;bottom:8px;left:50%;transform:translateX(-50%);width:16px;height:3px;background:#6BC79E;border-radius:2px}
.framework-viz__mentor-cards{display:grid;grid-template-columns:1fr 1fr;gap:6px}
.framework-viz__mentor-cards div{background:#E4E7EC;border-radius:5px;height:38px}
.framework-viz__qa-cards{display:flex;flex-direction:column;gap:5px;flex:1}
.framework-viz__qa-cards div{background:#E4E7EC;border-radius:4px;height:18px;flex:1}
.framework-viz__phone-tabs{display:grid;grid-template-columns:repeat(4,1fr);gap:2px;padding:8px 4px 4px;border-top:1px solid rgba(15,24,33,.08);margin-top:8px}
.framework-viz__tab{display:flex;flex-direction:column;align-items:center;gap:3px;font-size:8px;color:var(--c-body);font-weight:500}
.framework-viz__tab--active{color:var(--c-blue);font-weight:700}
.framework-viz__tab-icon{width:16px;height:16px;display:flex;align-items:center;justify-content:center;color:currentColor}
.framework-viz__tab-icon svg{width:14px;height:14px;display:block}
.framework-viz__tab--active .framework-viz__tab-icon svg{fill:var(--c-blue)}
.framework-viz__text{display:flex;align-items:center}
.framework-viz__text p{font-size:16px;line-height:1.7;color:var(--c-body);margin:0}
@media (max-width:900px){.framework-viz{grid-template-columns:1fr;gap:32px}.framework-viz__annos{padding-top:0;flex-direction:row;flex-wrap:wrap}}

/* ============ Reflections (staff-designer editorial: left category, right items) ============ */
.reflections__group{display:grid;grid-template-columns:1fr 2fr;gap:64px;padding:56px 0;border-top:1px solid rgba(15,24,33,.08);align-items:start}
.reflections__group:first-of-type{border-top:none;padding-top:24px}
.reflections__label{position:sticky;top:120px}
.reflections__label-kicker{font-size:12px;font-weight:700;color:var(--c-blue);letter-spacing:0.28em;text-transform:uppercase;margin:0 0 12px;font-family:var(--font-sans)}
.reflections__label-title{font-size:26px;font-weight:700;color:var(--c-text-deep);margin:0 0 12px;line-height:1.25;letter-spacing:-0.005em;font-family:var(--font-sans)}
.reflections__label-note{font-size:14px;color:var(--c-body);margin:0;line-height:1.5;font-weight:400;opacity:0.75;font-style:italic}
.reflections__items{display:flex;flex-direction:column;gap:32px}
.reflections__item h4{font-size:20px;font-weight:700;color:var(--c-text-deep);margin:0 0 12px;line-height:1.3;font-family:var(--font-sans);letter-spacing:-0.003em}
.reflections__item p{font-size:16px;color:var(--c-body);font-weight:400;line-height:1.7;margin:0}
.reflections__item p strong{color:var(--c-text-deep);font-weight:700}
@media (max-width:900px){.reflections__group{grid-template-columns:1fr;gap:32px;padding:40px 0}.reflections__label{position:static}}

/* ============ Closing ============ */
.closing{text-align:center;margin:var(--gap-l1-top) auto 80px;max-width:var(--container-width)}
.closing h2{font-size:56px;font-weight:700;color:var(--c-text-deep);margin:0 0 40px;letter-spacing:-0.01em}
.closing img{display:inline-block;margin:0 auto 24px}
.closing a{font-size:18px;color:var(--c-body);text-decoration:none;border-bottom:1px solid currentColor;padding-bottom:2px}

/* Footer */
.site-footer{padding:60px 24px;text-align:center;font-size:15px;color:#4A5868}

/* ============ Responsive ============ */
@media (max-width:1080px){
  :root{--container-width:100%;--side-pad:24px;--gap-l1-top:120px;--gap-l2-top:56px;--container-pad:48px}
  .nav{gap:48px}
  .l1{font-size:48px}
  .why-container{padding:48px 56px}
}
@media (max-width:900px){
  :root{--side-pad:20px;--gap-l1-top:96px;--gap-l2-top:48px}
  .nav{gap:32px}
  .l1{font-size:42px}
  .l2{font-size:22px}
  .p{font-size:17px}
  .cs-meta-box{padding:36px 40px;gap:32px}
}
@media (max-width:768px){
  :root{--side-pad:24px;--gap-l1-top:80px;--gap-l2-top:40px}
  .site-header{height:68px}
  .brand{font-size:16px;gap:10px;white-space:nowrap}
  .brand-avatar,.brand-avatar img{width:34px;height:36px}
  .nav{gap:24px}
  .nav a{font-size:15px}
  .l1{font-size:36px}
  .l2{font-size:20px}
  .p{font-size:16px}
  .cs-meta-box{grid-template-columns:1fr;padding:32px 28px;gap:16px}
  .two-col,.text-img{grid-template-columns:1fr;gap:32px}
  .design-goal-card{padding:48px 32px;min-height:auto}
  .design-goal-card__circle{position:relative;left:auto;top:auto;transform:none;width:200px;height:200px;margin:0 auto 32px}
  .design-goal-card__copy{margin-left:0;text-align:center}
  .design-goal-card__copy ul{display:inline-block;text-align:left}
  .text-img--imgleft .text-img__media,.text-img--imgleft .text-img__copy{order:0}
  .principles{grid-template-columns:repeat(2,1fr)}
  .why-container{padding:32px 28px}
  .why-container .quotes{grid-template-columns:1fr;gap:16px}
  .callout-blue{padding:24px 28px}
  .emoji-list{padding-left:24px}
  .closing h2{font-size:36px}
}
@media (max-width:600px){
  :root{--side-pad:20px}
  .site-header{height:60px}
  .brand span{font-size:15px}
  .brand-avatar,.brand-avatar img{width:30px;height:32px}
  .nav{gap:18px}
  .nav a{font-size:14px}
  .l1{font-size:30px}
  .principles{grid-template-columns:1fr;gap:20px}
}
@media (max-width:380px){
  :root{--side-pad:16px}
  .nav{gap:14px}
  .nav a{font-size:13px}
  .brand span{font-size:14px}
}
  
/* ============ Header unified — fixed max-width across all pages (kills nav jitter) ============ */
.site-header__inner{max-width:1200px !important;margin:0 auto !important;padding:0 24px !important;width:100% !important;box-sizing:border-box}


/* ============ Nav unified — same size/spacing across all pages & breakpoints (kills switch-jitter) ============ */
.nav{display:flex !important;gap:48px !important;align-items:center !important}
.nav a{font-size:16px !important;font-weight:500 !important;padding:6px 0 !important}
@media (max-width:900px){.nav{gap:32px !important}}
@media (max-width:600px){.nav{gap:20px !important}}




/* ============ Cross-page View Transitions (Chrome/Edge 126+, Safari 18+) ============ */
@view-transition { navigation: auto; }
::view-transition-old(root),::view-transition-new(root){animation-duration:.18s;animation-timing-function:cubic-bezier(.4,0,.2,1);mix-blend-mode:normal}
::view-transition-old(root){animation-name:vt-fade-out}
::view-transition-new(root){animation-name:vt-fade-in}
@keyframes vt-fade-out{to{opacity:0}}
@keyframes vt-fade-in{from{opacity:0}}


/* ============ Case-study scroll reveal (Framer/Linear style) ============ */
.cs-reveal{opacity:0;transform:translateY(12px);transition:opacity .7s cubic-bezier(.4,0,.2,1),transform .7s cubic-bezier(.4,0,.2,1)}
.cs-reveal.is-visible{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.cs-reveal{opacity:1 !important;transform:none !important}}


.wow-progress{position:fixed;top:0;left:0;height:2px;background:#F5A623;width:0%;z-index:9999;transition:width .1s ease-out}


/* Site-wide signature stamp (in footer) */
.wow-sig{font-family:var(--font-sans);font-size:13px;font-weight:700;color:var(--color-text-muted,#4A5868);letter-spacing:0.28em;text-transform:uppercase;margin:0;opacity:0.65;text-align:center}



/* Message design specifics */
.audit-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;max-width:var(--container-width);margin:16px auto 40px}
.audit-grid figure{margin:0;display:flex;flex-direction:column;gap:6px}
.audit-grid img{width:100%;height:auto;border-radius:8px;display:block;background:#F4F7FA}
.audit-grid figcaption{font-size:11px;font-weight:700;color:var(--c-body);letter-spacing:0.14em;text-transform:uppercase;font-family:var(--font-sans)}
@media (max-width:768px){.audit-grid{grid-template-columns:1fr 1fr}}
.personas-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:32px;max-width:var(--container-width);margin:24px auto 48px}
.persona{background:var(--c-container-bg);border-radius:16px;padding:32px 28px 28px;text-align:left;display:flex;flex-direction:column;gap:14px}
.persona img{width:120px;height:auto;align-self:center;background:transparent}
.persona__name{font-family:var(--font-sans);font-size:15px;font-weight:700;color:var(--c-text-deep);margin:8px 0 0;letter-spacing:-0.003em}
.persona__desc{font-size:14px;line-height:1.6;color:var(--c-body);margin:0;font-weight:400}
.persona__desc strong{color:var(--c-text-deep);font-weight:700}
@media (max-width:768px){.personas-grid{grid-template-columns:1fr;gap:16px}}
.wireframes-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;max-width:var(--container-width);margin:24px auto 40px}
.wireframes-grid figure{margin:0;position:relative;background:#F4F7FA;border-radius:8px;overflow:hidden}
.wireframes-grid img{width:100%;height:auto;display:block}
.wireframes-grid figcaption{position:absolute;top:8px;left:8px;font-family:var(--font-sans);font-size:10px;font-weight:700;color:var(--c-blue);letter-spacing:0.16em;background:rgba(255,255,255,.92);padding:3px 8px;border-radius:4px}
@media (max-width:768px){.wireframes-grid{grid-template-columns:1fr 1fr}}
.results-metrics-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;max-width:var(--container-width);margin:24px auto 40px}
.results-mm{background:#F9FAFB;border-radius:16px;padding:28px 24px}
.results-mm__num{font-family:var(--font-sans);font-size:44px;font-weight:800;color:var(--c-blue);line-height:0.9;letter-spacing:-0.03em;margin:0 0 10px;font-feature-settings:"tnum"}
.results-mm__unit{font-size:24px;font-weight:700;margin-left:2px}
.results-mm__label{font-size:13px;font-weight:600;color:var(--c-body);margin:0;line-height:1.4;font-family:var(--font-sans)}
@media (max-width:768px){.results-metrics-grid{grid-template-columns:1fr 1fr}}


/* Recap card — pain point quote + UI evidence grouped */
.recap-card{max-width:var(--container-width);margin:32px auto 40px;padding:40px 48px;background:#F4F7FA;border-radius:20px;display:flex;flex-direction:column;gap:24px;align-items:center}
.recap-card__overline{font-family:var(--font-sans);font-size:11px;font-weight:700;color:var(--c-blue);letter-spacing:0.22em;text-transform:uppercase;margin:0;align-self:flex-start}
.recap-card__quote{max-width:820px;width:100%}
.recap-card__quote img{width:100%;height:auto;display:block;border-radius:8px}
.recap-card__caption{font-family:var(--font-sans);font-size:13px;font-weight:600;color:var(--c-body);margin:0;font-style:italic;opacity:0.8}
.recap-card__evidence{max-width:720px;width:100%}
.recap-card__evidence img{width:100%;height:auto;display:block;border-radius:8px}
@media (max-width:768px){.recap-card{padding:24px 20px;gap:16px}}


/* Scenarios group — consistent width/style for scenario flow images */
.scenarios-group{max-width:1400px;margin:32px auto 40px;padding:0 24px;display:flex;flex-direction:column;gap:24px}
.scenarios-group__item{overflow:hidden}
.scenarios-group__item img{width:100%;height:auto;display:block}
@media (max-width:900px){.scenarios-group{padding:0 16px}}


/* Pain point recap — HTML quote + swipe state diagram */
.painpoint{max-width:900px;margin:32px auto 40px;padding:40px 44px;background:#F4F7FA;border-radius:20px}
.painpoint__overline{font-family:var(--font-sans);font-size:11px;font-weight:700;color:var(--c-blue);letter-spacing:0.22em;text-transform:uppercase;margin:0 0 20px}
.painpoint__quote{margin:0 0 32px;padding:0}
.painpoint__quote p{font-family:var(--font-sans);font-size:22px;line-height:1.4;color:var(--c-text-deep);font-weight:400;letter-spacing:-0.006em;margin:0 0 14px;font-style:italic}
.painpoint__quote p strong{color:var(--c-blue);font-weight:600;font-style:normal}
.painpoint__quote footer{font-size:12px;font-weight:600;color:var(--c-body);letter-spacing:0.08em;text-transform:uppercase;font-style:normal;font-family:var(--font-sans);display:flex;align-items:center;gap:6px}
.painpoint__avatar{display:inline-flex;align-items:center;justify-content:center;width:22px;height:22px;background:#DDE4EC;border-radius:50%;font-style:normal;font-size:12px}

.swipe-states{display:flex;flex-direction:column;gap:14px;margin:24px 0}
.swipe-row{position:relative;display:grid;grid-template-columns:120px 1fr;gap:6px;border-radius:8px;overflow:visible;font-family:var(--font-sans)}
.swipe-row:last-child{grid-template-columns:1fr 120px}
.swipe-row__msg{background:#fff;padding:16px 18px;display:flex;align-items:center;gap:12px;border-radius:6px;position:relative}
.swipe-row__avatar{width:36px;height:36px;background:linear-gradient(135deg,#8DB8E8,#3D7CBF);border-radius:50%;flex-shrink:0}
.swipe-row__body{flex:1;min-width:0}
.swipe-row__name{font-size:14px;font-weight:700;color:var(--c-text-deep);margin:0 0 3px}
.swipe-row__preview{font-size:12px;color:var(--c-body);margin:0}
.swipe-row__time{font-size:11px;color:var(--c-body);opacity:0.7;margin:0}
.swipe-row__action{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;color:#fff;font-size:12px;font-weight:700;letter-spacing:-0.002em;text-align:center;padding:12px;border-radius:6px}
.swipe-row__action--right{background:#0A66C2}
.swipe-row__action--left{background:#7A8390}
.swipe-row__icon{font-size:20px;line-height:1}
.swipe-row__label{line-height:1.25}
.swipe-row__hint{grid-column:1 / -1;font-size:12px;font-style:italic;color:var(--c-body);margin:6px 0 0;font-weight:500;opacity:0.85}
.swipe-row__hint strong{color:var(--c-text-deep);font-style:normal;font-weight:700}

.painpoint__evidence{margin:24px 0;max-width:720px;margin-left:auto;margin-right:auto}
.painpoint__evidence img{width:100%;height:auto;display:block;border-radius:10px}
.painpoint__evidence figcaption{font-family:var(--font-sans);font-size:12px;font-weight:500;color:var(--c-body);font-style:italic;text-align:center;margin-top:12px;opacity:0.75}
.painpoint__insight{font-family:var(--font-sans);font-size:14px;line-height:1.6;color:var(--c-text-deep);margin:24px 0 0;font-weight:500;padding:16px 0 0;border-top:1px solid rgba(15,24,33,.08)}
@media (max-width:768px){.painpoint{padding:24px 20px}.painpoint__quote p{font-size:18px}.swipe-row,.swipe-row:last-child{grid-template-columns:1fr}}

</style>
</head>

<body>

  <header class="site-header">
    <div class="container site-header__inner">
      <a href="../index.html" class="brand" aria-label="Shilue's Portfolio home">
        <span class="brand-avatar"><img loading="eager" decoding="async" fetchpriority="high" class="brand-avatar__default" src="../images/avatar-header.png" alt="Shilue logo" /><img loading="lazy" decoding="async" class="brand-avatar__hover" src="../images/avatar-header-hover.png" alt="" /></span>
        <span>Shilue's Portfolio</span>
      </a>
      <nav class="nav" aria-label="Main">
        <a href="../index.html" class="is-active">Projects</a>
        <a href="../playgrounds/index.html">Playgrounds</a>
        <a href="../resume.html">About</a>
      </nav>
    </div>
  </header>

  <main>

    <!-- ============ 1. Cover ============ -->
    <section class="cs-cover" id="cover">
      <!-- COVER PLACEHOLDER — replace ../images/ai-search-cover.[avif|png|jpg] once art is ready.
           Suggested composition: a single frame showing three surfaces (EPIC results / Search × AI Chat entry / AI Personalization filter) with the pull-quote "What did you type? → What do you really want?" typeset over the top. -->
      <div class="cs-cover-placeholder" role="img" aria-label="AI Search cover — placeholder">
        <div class="cs-cover-placeholder__inner">
          <span class="cs-cover-placeholder__eyebrow">Trip.com Search · 2024–Now</span>
          <span class="cs-cover-placeholder__q-old">&ldquo;What did you type?&rdquo;</span>
          <span class="cs-cover-placeholder__arrow" aria-hidden="true">↓</span>
          <span class="cs-cover-placeholder__q-new">&ldquo;What do you <em>really</em> want?&rdquo;</span>
          <span class="cs-cover-placeholder__stages">EPIC &nbsp;·&nbsp; Search × AI Chat &nbsp;·&nbsp; AI Personalization</span>
          <span class="cs-cover-placeholder__note">Cover artwork placeholder</span>
        </div>
      </div>
    </section>

    <!-- ============ 2. Meta strip ============ -->
    <section class="container">
      <p class="meta-badge">Trip.com · IBU Search · 2024–Now</p>
      <div class="cs-meta-box">
        <div>
          <p class="cs-meta-h">Project</p>
          <p class="cs-meta-p">Reframing Trip.com Search for the AI era</p>
          <p class="cs-meta-h">Role</p>
          <p class="cs-meta-p">Search Design Lead — vision, strategy, and hands-on design across all three initiatives.</p>
          <p class="cs-meta-h">Team</p>
          <p class="cs-meta-p">Partnered with PM, engineering, LLM research, ranking, and 10+ business lines. Dotted-line mentorship of 2 designers (started recently).</p>
        </div>
        <div>
          <p class="cs-meta-h">Scope</p>
          <p class="cs-meta-p">Three staged design initiatives spanning ~2 years — EPIC (complex-intent understanding), Search × AI Chat (unified entry), AI Personalization (decision support).</p>
          <p class="cs-meta-h">Deliverables</p>
          <p class="cs-meta-p">Strategic framing, product flows, interaction models, high-fidelity design, and cross-team alignment across shipped and in-flight surfaces.</p>
        </div>
      </div>
    </section>

    <!-- ============ 3. Opening ============ -->
    <section class="container">
      <h1 class="l1">01 &nbsp; Reframing Search</h1>
      <h2 class="l2">From Query Matching to Travel Decisions</h2>

      <div class="op-beat">
        <p class="op-beat__label"><span class="op-beat__label-num">01</span> Where I Started</p>
        <p class="p">
          When I took ownership of Trip.com Search as <strong class="dark">Design Lead</strong>, my first major move was to make what Search already did — better. I led a systemic redesign of the <strong class="dark">search results page (SERP)</strong> — restructuring destination, attraction, transportation, and themed-travel results around query intent, and using real click behavior to surface cross-business hooks most likely to spark further exploration or purchase.
        </p>

        <p class="p">
          The design lever was a framework I built called <strong class="dark">Match &amp; Inspire</strong> — each SERP first matched the explicit need, then inspired adjacent possibilities tuned to that intent.
        </p>

        <p class="p">The impact was measurable and significant:</p>

        <!-- METRICS: replace XX with actual numbers once Shirley confirms -->
        <div class="op-metrics" aria-label="Impact of the intent-based SERP redesign">
          <div class="op-metric">
            <span class="op-metric__value">+XX%</span>
            <span class="op-metric__label">Booking conversion</span>
            <span class="op-metric__note">post-search purchase</span>
          </div>
          <div class="op-metric">
            <span class="op-metric__value">+XX%</span>
            <span class="op-metric__label">Cross-business CTR</span>
            <span class="op-metric__note">hotels · attractions · transport</span>
          </div>
        </div>

      </div><!-- /op-beat 01 -->

      <div class="op-beat">
        <p class="op-beat__label"><span class="op-beat__label-num">02</span> The Ceiling</p>
        <p class="p">
          The redesign sharpened intent matching — but it still relied on <strong class="dark">inference</strong>. We could predict what might be relevant next, but not <em>understand</em> the underlying goal, the missing information, or the decision the user was trying to make.
        </p>

        <div class="op-hero-query" aria-label="The query that showed the ceiling">
          <span class="op-hero-query__eyebrow">The query that showed the ceiling</span>
          <p class="op-hero-query__q">Where should I take my parents this summer?</p>
          <div class="op-hero-query__gaps">
            <div class="op-hero-query__gap">
              <span class="op-hero-query__gap-label">What SERP couldn&rsquo;t parse</span>
              <span class="op-hero-query__gap-value">the <em>intent</em></span>
              <span class="op-hero-query__gap-note">bonding? bucket-list? relaxation?</span>
            </div>
            <div class="op-hero-query__gap">
              <span class="op-hero-query__gap-label">What SERP couldn&rsquo;t fill</span>
              <span class="op-hero-query__gap-value">the <em>missing info</em></span>
              <span class="op-hero-query__gap-note">budget, kids, mobility, prefs</span>
            </div>
            <div class="op-hero-query__gap">
              <span class="op-hero-query__gap-label">What SERP couldn&rsquo;t shape</span>
              <span class="op-hero-query__gap-value">the <em>decision</em></span>
              <span class="op-hero-query__gap-note">where, when, how long, with whom</span>
            </div>
          </div>
        </div>

      </div><!-- /op-beat 02 -->

      <div class="op-beat">
        <p class="op-beat__label"><span class="op-beat__label-num">03</span> The Capability Shift</p>
        <p class="p">
          That was where AI stopped being a trend and became a strategic necessity. Looking at the redesign's ceiling, <strong class="dark">I diagnosed three specific gaps</strong> that no amount of ranking could close:
        </p>

        <div class="op-shifts-viz" aria-label="Three capability shifts AI enables in Search">
        <div class="op-shift">
          <div class="op-shift__arrow"><span class="op-shift__from">Retrieval</span><span class="op-shift__arrow-sep">→</span><span class="op-shift__to">Understanding</span></div>
          <h4 class="op-shift__title">We could retrieve, but not deeply <em>understand</em>.</h4>
          <p class="op-shift__desc">Parse complex, natural goals and the relationships between needs — not just keywords.</p>
        </div>
        <div class="op-shift">
          <div class="op-shift__arrow"><span class="op-shift__from">Information</span><span class="op-shift__arrow-sep">→</span><span class="op-shift__to">Decision</span></div>
          <h4 class="op-shift__title">We could expose information, but not help users <em>judge</em>.</h4>
          <p class="op-shift__desc">Synthesize scattered signals into decisions travelers can trust — help them choose, not just find.</p>
        </div>
        <div class="op-shift">
          <div class="op-shift__arrow"><span class="op-shift__from">Matching</span><span class="op-shift__arrow-sep">→</span><span class="op-shift__to">Inspiration</span></div>
          <h4 class="op-shift__title">We could match demand, but not <em>create</em> new possibilities.</h4>
          <p class="op-shift__desc">Turn vague or unspoken interest into a concrete trip — surface what travelers didn't know they wanted.</p>
        </div>
      </div>

      <p class="p">
        For an OTA, this reframes what Search <em>does</em>: from returning relevant supply to <strong class="dark">orchestrating a travel decision</strong>.
      </p>

      <div class="op-gateway" aria-label="Search model evolution: from intent-aware retrieval to decision-oriented Search">
        <div class="op-gw-panel op-gw-panel--before">
          <span class="op-gw-eyebrow">Before &middot; Intent-aware retrieval</span>
          <svg class="op-gw-svg op-gw-svg--before" viewBox="0 0 420 140" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Query to Intent to Relevant supply">
            <rect x="8" y="55" width="88" height="34" rx="8" fill="#fff" stroke="#c9d0d7" stroke-width="1.5"/>
            <text x="52" y="77" text-anchor="middle" font-size="13" font-weight="700" fill="#0F1821" font-family="Airbnb Cereal App, Inter, sans-serif">Query</text>
            <line x1="104" y1="72" x2="152" y2="72" stroke="#8b96a3" stroke-width="1.6"/>
            <polygon points="158,72 148,67 148,77" fill="#8b96a3"/>
            <rect x="160" y="55" width="88" height="34" rx="8" fill="#fff" stroke="#c9d0d7" stroke-width="1.5"/>
            <text x="204" y="77" text-anchor="middle" font-size="13" font-weight="700" fill="#0F1821" font-family="Airbnb Cereal App, Inter, sans-serif">Intent</text>
            <line x1="256" y1="72" x2="304" y2="72" stroke="#8b96a3" stroke-width="1.6"/>
            <polygon points="310,72 300,67 300,77" fill="#8b96a3"/>
            <rect x="312" y="55" width="102" height="34" rx="8" fill="#fff" stroke="#c9d0d7" stroke-width="1.5"/>
            <text x="363" y="77" text-anchor="middle" font-size="13" font-weight="700" fill="#0F1821" font-family="Airbnb Cereal App, Inter, sans-serif">Relevant supply</text>
          </svg>
          <p class="op-gw-caption">Match & Inspire made SERP smarter within retrieval&#39;s bounds.</p>
        </div>
        <div class="op-gw-panel op-gw-panel--after">
          <span class="op-gw-eyebrow">Next &middot; Decision-oriented Search</span>
          <svg class="op-gw-svg op-gw-svg--after" viewBox="0 0 420 200" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Intent to Understanding to Inspiration and Supply to Decision and Action">
            <rect x="6" y="82" width="88" height="34" rx="8" fill="#fff" stroke="#0A66C2" stroke-width="1.5"/>
            <text x="50" y="104" text-anchor="middle" font-size="13" font-weight="700" fill="#0F1821" font-family="Airbnb Cereal App, Inter, sans-serif">Intent</text>
            <line x1="98" y1="99" x2="140" y2="99" stroke="#0A66C2" stroke-width="1.6" opacity=".7"/>
            <polygon points="146,99 136,94 136,104" fill="#0A66C2" opacity=".7"/>
            <rect x="148" y="82" width="118" height="34" rx="8" fill="#0A66C2"/>
            <text x="207" y="104" text-anchor="middle" font-size="13" font-weight="800" fill="#fff" font-family="Airbnb Cereal App, Inter, sans-serif">Understanding</text>
            <line x1="270" y1="82" x2="290" y2="52" stroke="#0A66C2" stroke-width="1.6" opacity=".7"/>
            <line x1="270" y1="116" x2="290" y2="146" stroke="#0A66C2" stroke-width="1.6" opacity=".7"/>
            <rect x="292" y="38" width="88" height="30" rx="8" fill="#fff" stroke="#0A66C2" stroke-width="1.5"/>
            <text x="336" y="58" text-anchor="middle" font-size="12" font-weight="700" fill="#0F1821" font-family="Airbnb Cereal App, Inter, sans-serif">Inspiration</text>
            <rect x="292" y="132" width="88" height="30" rx="8" fill="#fff" stroke="#0A66C2" stroke-width="1.5"/>
            <text x="336" y="152" text-anchor="middle" font-size="12" font-weight="700" fill="#0F1821" font-family="Airbnb Cereal App, Inter, sans-serif">Supply</text>
            <path d="M 380 53 Q 400 100 400 100" stroke="#0A66C2" stroke-width="1.6" opacity=".7" fill="none"/>
            <path d="M 380 147 Q 400 100 400 100" stroke="#0A66C2" stroke-width="1.6" opacity=".7" fill="none"/>
            <text x="410" y="103" text-anchor="middle" font-size="15" font-weight="800" fill="#0A66C2" font-family="Airbnb Cereal App, Inter, sans-serif">→</text>
            <text x="207" y="180" text-anchor="middle" font-size="12" font-weight="700" fill="#0A66C2" font-family="Airbnb Cereal App, Inter, sans-serif" letter-spacing="1.5">DECISION &middot; ACTION</text>
          </svg>
          <p class="op-gw-caption">The next layer of Search: understand, orchestrate, and help decide.</p>
        </div>
      </div>

      </div><!-- /op-beat 03 -->

      <div class="op-beat">
        <p class="op-beat__label"><span class="op-beat__label-num">04</span> The Design North Star &amp; What Came Next</p>
        <p class="p">The obvious move was <em>&ldquo;add AI features to Search.&rdquo;</em> I chose a harder framing:</p>

        <figure class="opening-quote">
        <figcaption class="opening-quote__eyebrow">The design north star</figcaption>
        <blockquote class="opening-quote__body">Can Search go beyond matching what users type — and start understanding what they <em>really</em> want?</blockquote>
      </figure>

      <p class="p">
        That led to <strong class="dark">three staged bets</strong>, each answering one piece of that question:
      </p>

      <div class="op-roadmap" aria-label="Three staged bets that redefined Trip.com Search">
        <div class="op-roadmap__line" aria-hidden="true"></div>
        <div class="op-roadmap__row">
          <article class="op-node">
            <div class="op-node__num">01</div>
            <p class="op-node__q">Extend Search beyond retrieval</p>
            <p class="op-node__sub">Prove AI can understand and serve the complex tasks traditional SERP couldn&rsquo;t.</p>
            <p class="op-node__proj-full">EPIC</p>
            <span class="op-node__status">Shipped</span>
          </article>
          <article class="op-node">
            <div class="op-node__num">02</div>
            <p class="op-node__q">Define one intelligent Search model</p>
            <p class="op-node__sub">Let the system, not the user, choose the best handling between Search and AI Chat.</p>
            <p class="op-node__proj-full">Search × AI Chat</p>
            <span class="op-node__status">Shipped</span>
          </article>
          <article class="op-node">
            <div class="op-node__num">03</div>
            <p class="op-node__q">Move from understanding to decision support</p>
            <p class="op-node__sub">Help travelers converge choices, interpret recommendations, and take action.</p>
            <p class="op-node__proj-full">AI Personalization</p>
            <span class="op-node__status">Shipped</span>
          </article>
        </div>
      </div>

      <p class="op-roadmap__arc" aria-label="Progression across the three stages">
        <span>Understand</span><span class="op-roadmap__arc-sep">→</span>
        <span>Orchestrate</span><span class="op-roadmap__arc-sep">→</span>
        <span>Decide</span>
      </p>
      </div><!-- /op-beat 04 -->
    </section>

    <!-- ============ Footer nav placeholder for now ============ -->
    <section class="container">
      <nav class="next-case" aria-label="Case navigation">
        <a href="../index.html" class="next-case__back">← All projects</a>
        <span class="next-case__next" style="opacity:.5;pointer-events:none;">More sections coming soon…</span>
      </nav>
    </section>

  </main>

  <div class="wow-progress" id="wow-progress" aria-hidden="true"></div>

  <footer class="site-footer">
    <p class="wow-sig">SHILUE &nbsp;·&nbsp; 2026</p>
  </footer>

<script>
    (function () {
      // Header glass on scroll
      const header = document.querySelector('.site-header');
      let scrolled = false;
      const onScroll = () => {
        const isScrolled = window.scrollY > 16;
        if (isScrolled !== scrolled) { scrolled = isScrolled; header.classList.toggle('is-scrolled', scrolled); }
      };
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Section nav active-section highlight
      const sections = document.querySelectorAll('main section[id]');
      const dots = document.querySelectorAll('.section-nav__link[data-section]');
      const updateActiveSection = () => {
        const scrollPos = window.scrollY + window.innerHeight * 0.4;
        let activeId = '';
        sections.forEach(s => { if (s.offsetTop <= scrollPos) activeId = s.id; });
        dots.forEach(d => { const isActive = d.dataset.section === activeId; d.classList.toggle('is-active', isActive); if (isActive) d.setAttribute('aria-current', 'location'); else d.removeAttribute('aria-current'); });
      };
      window.addEventListener('scroll', updateActiveSection, { passive: true });
      updateActiveSection();

      // Circular scroll progress + back-to-top button
      const sectionNav = document.querySelector('.section-nav');
      const scrollBtn = document.querySelector('.scroll-progress');
      const progressRing = document.querySelector('.scroll-progress__fill');
      const updateProgress = () => {
        const scrollTop = window.scrollY;
        const docHeight = document.documentElement.scrollHeight - window.innerHeight;
        const progress = docHeight > 0 ? Math.min(100, Math.max(0, (scrollTop / docHeight) * 100)) : 0;
        progressRing.style.strokeDashoffset = 100 - progress;
        scrollBtn.classList.toggle('is-visible', scrollTop > 400);
      };
      window.addEventListener('scroll', updateProgress, { passive: true });
      updateProgress();
      scrollBtn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));

      // Nav behavior with asymmetric thresholds (matches dingtalk pattern):
      //  · Hero/intro area: main header always visible, section nav in natural flow
      //  · Content area (section nav stuck):
      //      - Scroll DOWN 20px accumulated → header hides
      //      - Scroll UP  3px accumulated → header reveals (fast intent response)
      let lastY = window.scrollY;
      let downAccum = 0, upAccum = 0;
      let wasStuck = false;
      const HIDE_THRESHOLD = 20;
      const SHOW_THRESHOLD = 3;
      let ticking = false;
      const checkNav = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const currentY = window.scrollY;
          const diff = currentY - lastY;
          const navTop = sectionNav.getBoundingClientRect().top;
          const stickyOffset = parseFloat(getComputedStyle(sectionNav).top) || 0;
          const isStuck = navTop <= stickyOffset + 1;

          sectionNav.classList.toggle('is-stuck', isStuck);

          if (!isStuck) {
            header.classList.remove('is-hidden');
            downAccum = 0; upAccum = 0;
          } else if (!wasStuck) {
            // Just became stuck — immediately hide header
            header.classList.add('is-hidden');
            downAccum = 0; upAccum = 0;
          } else {
            if (diff > 0) {
              downAccum += diff; upAccum = 0;
              if (downAccum > HIDE_THRESHOLD) header.classList.add('is-hidden');
            } else if (diff < 0) {
              upAccum += -diff; downAccum = 0;
              if (upAccum > SHOW_THRESHOLD) header.classList.remove('is-hidden');
            }
          }
          sectionNav.classList.toggle('below-header', !header.classList.contains('is-hidden'));
          wasStuck = isStuck;
          lastY = currentY;
          ticking = false;
        });
      };
      window.addEventListener('scroll', checkNav, { passive: true });
      checkNav();
    })();
  </script>

<script>
  // Prefetch same-origin html links on hover — near-instant navigation
  (function(){
    var prefetched = new Set();
    document.addEventListener('mouseover', function(e){
      var link = e.target.closest && e.target.closest('a[href]');
      if (!link) return;
      var href = link.href;
      if (!href || prefetched.has(href)) return;
      // Only same-origin html
      try { var u = new URL(href, location.href); if (u.origin !== location.origin) return; } catch(e){ return; }
      if (!/\.html($|\?|#)/.test(u.pathname) && u.pathname !== '/' && !u.pathname.endsWith('/')) return;
      var l = document.createElement('link');
      l.rel = 'prefetch'; l.href = href; l.as = 'document';
      document.head.appendChild(l);
      prefetched.add(href);
    }, { passive: true });
  })();
</script>

<script>
  // Case-study scroll reveal — auto-tag major content blocks, then observe
  (function(){
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    var selectors = [
      '.container > h1.l1','.container > h2.l1','.container > h3.l2','.container > h4.l3',
      '.container > .p','.container > .p--muted','.container > p.p',
      '.container > .img','.container > .img--wide','.container > .img--full',
      '.container > .callout-blue','.container > .why-container',
      '.container > .step-block','.container > .challenge-block',
      '.container > .two-col','.container > .text-img',
      '.container > .uc-block','.container > .principles','.container > .design-goal-card',
      '.container > .findings-grid','.container > .results-flow','.container > .results-metrics','.container > .results-qual',
      '.container > .framework-viz','.container > .reflections','.container > .reflections__group',
      '.container > .quote-box','.container > .highlight-center',
      '.alts-wrap','.soc-wrap',
      '.container > .cs-meta-box','.container > .cs-cover',
      '.container > .recap-card','.container > .gray-block',
      '.container > .dc-solution',
    ];
    var els = document.querySelectorAll(selectors.join(','));
    if (!els.length) return;
    els.forEach(function(el){ el.classList.add('cs-reveal'); });
    if (!('IntersectionObserver' in window)){
      els.forEach(function(el){ el.classList.add('is-visible'); });
      return;
    }
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(e){
        if (e.isIntersecting){ e.target.classList.add('is-visible'); io.unobserve(e.target); }
      });
    }, { threshold: 0.08, rootMargin: '0px 0px -60px 0px' });
    els.forEach(function(el){ io.observe(el); });
  })();
</script>


<script>
(function(){
  if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
  var b = document.createElement('div');
  b.className = 'wow-progress';
  document.body.appendChild(b);
  function u(){ var h = document.documentElement.scrollHeight - window.innerHeight; b.style.width = (h>0 ? Math.min(100,window.scrollY/h*100) : 0) + '%'; }
  window.addEventListener('scroll', u, { passive: true });
  u();
})();
</script>

</body>
</html>
